<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SVDAgency" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_red_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/black</item>

        <item name="colorSurface">@color/surface_background</item>
        <item name="colorOnSurface">@color/textColorPrimary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/textColorSecondary</item>
        <item name="colorBackground">@color/window_background</item>

        <item name="colorSurfaceContainer">@color/surface_background</item>
        <item name="colorSurfaceContainerHigh">@color/surface_background</item>
        <item name="colorSurfaceContainerHighest">@color/surface_background</item>
        <item name="colorSurfaceContainerLow">@color/surface_background</item>
        <item name="colorSurfaceContainerLowest">@color/surface_background</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/brand_red</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Window Background -->
        <item name="android:windowBackground">@color/window_background</item>

        <!-- Material Card Styling -->
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>

        <!-- Navigation View Styling -->
        <item name="navigationViewStyle">@style/Widget.App.NavigationView</item>

        <!-- Bottom Navigation Styling -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>

        <!-- Dialog Styling -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke_color</item>
    </style>

    <style name="Widget.App.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="backgroundTint">@color/drawer_background</item>
        <item name="elevation">0dp</item>
        <item name="itemTextColor">@color/drawer_nav_item_colors</item>
        <item name="itemIconTint">@color/drawer_nav_icon_colors</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface_background</item>
        <item name="itemTextColor">@color/textColorSecondary</item>
        <item name="itemIconTint">@color/textColorSecondary</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_background</item>
        <!-- Use windowBackground instead of surfaceTint to avoid build errors and fix the pinkish background -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
