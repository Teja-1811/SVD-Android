<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    tools:context=".ui.admin.stock.AdminStockActivity">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOOLBAR -->
        <include
            layout="@layout/admin_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.svd.svdagencies.utils.AppSwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="@dimen/card_corner_radius_small"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/card_stroke_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Date-wise Crate Records"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDateRecordsSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Saved crates for selected date."
                                android:textColor="@color/textColorSecondary"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <EditText
                                    android:id="@+id/etRecordDate"
                                    android:layout_width="0dp"
                                    android:layout_height="42dp"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_stock_date_field"
                                    android:clickable="true"
                                    android:focusable="false"
                                    android:gravity="center"
                                    android:hint="Date"
                                    android:inputType="none"
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnManageStock"
                                    android:layout_width="wrap_content"
                                    android:layout_height="42dp"
                                    android:minWidth="118dp"
                                    android:paddingHorizontal="14dp"
                                    android:text="Add / Edit"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="@color/brand_red"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvNoDateRecords"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="No crate records found for this date."
                                android:textColor="@color/textColorSecondary"
                                android:visibility="gone" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvDateEntries"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:nestedScrollingEnabled="false"
                                tools:listitem="@layout/admin_stock_info_item" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- STATS GRID -->
                    <androidx.gridlayout.widget.GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:columnCount="2"
                        app:rowCount="2">

                        <!-- Total Items -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:layout_columnWeight="1"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_stroke_color"
                            android:background="?attr/colorSurface"
                            app:cardBackgroundColor="?attr/colorSurface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical"
                                android:background="?attr/colorSurface">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Total Items"
                                        android:textColor="@color/textColorSecondary"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:textAllCaps="true"/>

                                    <TextView
                                        android:id="@+id/tvTotalItems"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/brand_blue"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="4dp"/>
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_box"
                                    app:tint="@color/brand_blue"
                                    android:background="@drawable/bg_qty_outline"
                                    android:backgroundTint="@color/bg_light_gray"
                                    android:padding="4dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Total Stock Value -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:layout_columnWeight="1"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_stroke_color"
                            android:background="?attr/colorSurface"
                            app:cardBackgroundColor="?attr/colorSurface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical"
                                android:background="?attr/colorSurface">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Total Stock Value"
                                        android:textColor="@color/textColorSecondary"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:textAllCaps="true"/>

                                    <TextView
                                        android:id="@+id/tvTotalValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="₹0.00"
                                        android:textColor="@color/icon_green"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="4dp"/>
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_money"
                                    app:tint="@color/icon_green"
                                    android:background="@drawable/bg_qty_outline"
                                    android:backgroundTint="@color/bg_light_gray"
                                    android:padding="4dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Low Stock Items -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:layout_columnWeight="1"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_stroke_color"
                            android:background="?attr/colorSurface"
                            app:cardBackgroundColor="?attr/colorSurface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical"
                                android:background="?attr/colorSurface">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Low Stock Items"
                                        android:textColor="@color/textColorSecondary"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:textAllCaps="true"/>

                                    <TextView
                                        android:id="@+id/tvLowStock"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/icon_orange"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="4dp"/>
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_warning"
                                    app:tint="@color/icon_orange"
                                    android:background="@drawable/bg_qty_outline"
                                    android:backgroundTint="@color/bg_light_gray"
                                    android:padding="4dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- 30-Day Movement -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:layout_columnWeight="1"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_stroke_color"
                            android:background="?attr/colorSurface"
                            app:cardBackgroundColor="?attr/colorSurface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical"
                                android:background="?attr/colorSurface">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="30-Day Movement"
                                        android:textColor="@color/textColorSecondary"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:textAllCaps="true"/>

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginTop="4dp">

                                        <TextView
                                            android:id="@+id/tvMovementIn"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="In: 0"
                                            android:textColor="@color/icon_green"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text=" | "
                                            android:textColor="@color/textColorSecondary"
                                            android:textSize="10sp" />

                                        <TextView
                                            android:id="@+id/tvMovementOut"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Out: 0"
                                            android:textColor="@color/brand_red"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_swap"
                                    app:tint="@color/brand_blue"
                                    android:background="@drawable/bg_qty_outline"
                                    android:backgroundTint="@color/bg_light_gray"
                                    android:padding="4dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Monthly Leakage Loss -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:layout_columnWeight="1"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_stroke_color"
                            app:cardBackgroundColor="?attr/colorSurface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Monthly Leakage Loss"
                                    android:textAllCaps="true"
                                    android:textColor="@color/textColorSecondary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMonthlyLeakage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Rs. 0.00"
                                    android:textColor="@color/brand_red"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </androidx.gridlayout.widget.GridLayout>

                    <!-- CHARTS SECTION -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <!-- Top 10 Items Chart -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="@dimen/card_corner_radius_small"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_stroke_color"
                            android:background="?attr/colorSurface"
                            app:cardBackgroundColor="?attr/colorSurface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/colorSurface"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_graph"
                                        app:tint="@color/textColorSecondary" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:text="Top 10 Items by Stock Value"
                                        android:textColor="@color/textColorPrimary"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <com.github.mikephil.charting.charts.BarChart
                                    android:id="@+id/barChart"
                                    android:layout_width="match_parent"
                                    android:layout_height="250dp"
                                    android:layout_marginTop="16dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Company-wise Stock Value Chart -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="@dimen/card_corner_radius_small"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_stroke_color"
                            android:background="?attr/colorSurface"
                            app:cardBackgroundColor="?attr/colorSurface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/colorSurface"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_snowflake"
                                        app:tint="@color/textColorSecondary" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:text="Company-wise Stock Value"
                                        android:textColor="@color/textColorPrimary"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <com.github.mikephil.charting.charts.PieChart
                                    android:id="@+id/pieChart"
                                    android:layout_width="match_parent"
                                    android:layout_height="250dp"
                                    android:layout_marginTop="16dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- CURRENT STOCK OVERVIEW TABLE -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="@dimen/card_corner_radius_small"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/card_stroke_color"
                        android:background="?attr/colorSurface"
                        app:cardBackgroundColor="?attr/colorSurface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/colorSurface"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_menu"
                                    app:tint="@color/textColorSecondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Current Stock Overview"
                                    android:textColor="@color/textColorPrimary"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <!-- Table Header -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@color/brand_red_dark"
                                        android:orientation="horizontal"
                                        android:paddingVertical="10dp"
                                        android:paddingHorizontal="4dp">

                                        <TextView
                                            android:layout_width="180dp"
                                            android:layout_height="wrap_content"
                                            android:text="ITEM"
                                            android:textColor="@color/white"
                                            android:textSize="11sp"
                                            android:textStyle="bold"
                                            android:paddingStart="8dp" />

                                        <TextView
                                            android:layout_width="80dp"
                                            android:layout_height="wrap_content"
                                            android:text="CURRENT"
                                            android:textColor="@color/white"
                                            android:textSize="11sp"
                                            android:textStyle="bold"
                                            android:gravity="center" />

                                        <TextView
                                            android:layout_width="80dp"
                                            android:layout_height="wrap_content"
                                            android:text="BUYING"
                                            android:textColor="@color/white"
                                            android:textSize="11sp"
                                            android:textStyle="bold"
                                            android:gravity="center" />

                                        <TextView
                                            android:layout_width="100dp"
                                            android:layout_height="wrap_content"
                                            android:text="VALUE"
                                            android:textColor="@color/white"
                                            android:textSize="11sp"
                                            android:textStyle="bold"
                                            android:gravity="center" />
                                    </LinearLayout>

                                    <!-- Stock List RecyclerView -->
                                    <androidx.recyclerview.widget.RecyclerView
                                        android:id="@+id/rvStockOverview"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        tools:itemCount="5"
                                        tools:listitem="@layout/admin_stock_overview" />

                                </LinearLayout>
                            </HorizontalScrollView>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="@dimen/card_corner_radius_small"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/card_stroke_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Leakage Register"
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnLeakageReport"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="0dp"
                                    android:paddingHorizontal="8dp"
                                    android:text="Report"
                                    android:textAllCaps="false"
                                    android:textColor="@color/textColorPrimary"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnRecordLeakage"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="0dp"
                                    android:padding="0dp"
                                    android:text="+ Record"
                                    android:textAllCaps="false"
                                    android:textColor="@color/brand_red"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Track product leakage, stock reduction, and buying-price based loss."
                                android:textColor="@color/textColorSecondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvNoLeakage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="No leakage records found for the selected month."
                                android:textColor="@color/textColorSecondary"
                                android:visibility="gone" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvLeakageEntries"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:nestedScrollingEnabled="false"
                                tools:listitem="@layout/admin_stock_info_item" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.svd.svdagencies.utils.AppSwipeRefreshLayout>
    </LinearLayout>

    <!-- DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:layout_gravity="start"
        app:headerLayout="@layout/admin_nav_header"
        app:itemIconTint="@color/drawer_nav_icon_colors"
        app:itemTextColor="@color/drawer_nav_item_colors"
        app:menu="@menu/menu_admin_drawer"/>

</androidx.drawerlayout.widget.DrawerLayout>
