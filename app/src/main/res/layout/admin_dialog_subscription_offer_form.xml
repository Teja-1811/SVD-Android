<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:fillViewport="true">
    <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/svd_space_section">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Subscription name" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />
        <EditText style="@style/Widget.Svd.PlainInput" android:id="@+id/etSubscriptionOfferName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="" android:minHeight="@dimen/svd_touch_target" android:background="@drawable/bg_qty_outline" android:padding="14dp" android:layout_marginTop="0dp" android:textSize="@dimen/svd_text_body" android:textColor="@color/textColorPrimary" android:singleLine="true"  android:minWidth="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Description" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />
        <EditText style="@style/Widget.Svd.PlainInput" android:id="@+id/etSubscriptionOfferDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="" android:minHeight="@dimen/svd_touch_target" android:background="@drawable/bg_qty_outline" android:padding="14dp" android:layout_marginTop="0dp" android:textSize="@dimen/svd_text_body" android:textColor="@color/textColorPrimary" android:gravity="top" android:inputType="textMultiLine"  android:minWidth="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Duration" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />
        <EditText style="@style/Widget.Svd.PlainInput" android:id="@+id/etSubscriptionDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="" android:inputType="number" android:minHeight="@dimen/svd_touch_target" android:background="@drawable/bg_qty_outline" android:padding="14dp" android:layout_marginTop="0dp" android:textSize="@dimen/svd_text_body" android:textColor="@color/textColorPrimary" android:singleLine="true"  android:minWidth="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Duration unit" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />
        <Spinner android:popupBackground="@drawable/bg_delivery_dropdown" android:id="@+id/spinnerSubscriptionDurationUnit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/svd_touch_target" android:background="@drawable/bg_qty_outline" android:layout_marginTop="0dp" android:padding="8dp" android:textColor="@color/textColorPrimary"  android:minWidth="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Delivery frequency" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />
        <Spinner android:popupBackground="@drawable/bg_delivery_dropdown" android:id="@+id/spinnerSubscriptionFrequency" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/svd_touch_target" android:background="@drawable/bg_qty_outline" android:layout_marginTop="0dp" android:padding="8dp" android:textColor="@color/textColorPrimary"  android:minWidth="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Product" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />
        <Spinner android:popupBackground="@drawable/bg_delivery_dropdown" android:id="@+id/spinnerSubscriptionItem" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/svd_touch_target" android:background="@drawable/bg_qty_outline" android:layout_marginTop="0dp" android:padding="8dp" android:textColor="@color/textColorPrimary"  android:minWidth="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quantity per delivery" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />
        <EditText style="@style/Widget.Svd.PlainInput" android:id="@+id/etSubscriptionItemQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="" android:inputType="number" android:minHeight="@dimen/svd_touch_target" android:background="@drawable/bg_qty_outline" android:padding="14dp" android:layout_marginTop="0dp" android:textSize="@dimen/svd_text_body" android:textColor="@color/textColorPrimary" android:singleLine="true"  android:minWidth="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Price per unit (₹)" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />
        <EditText style="@style/Widget.Svd.PlainInput" android:id="@+id/etSubscriptionItemPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="" android:inputType="numberDecimal" android:minHeight="@dimen/svd_touch_target" android:background="@drawable/bg_qty_outline" android:padding="14dp" android:layout_marginTop="0dp" android:textSize="@dimen/svd_text_body" android:textColor="@color/textColorPrimary" android:singleLine="true"  android:minWidth="48dp" />
    </com.svd.svdagencies.utils.CompactLinearLayout>
</ScrollView>