<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <EditText android:id="@+id/etSubscriptionOfferName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Subscription name" />
        <EditText android:id="@+id/etSubscriptionOfferDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Description" />
        <EditText android:id="@+id/etSubscriptionDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Duration value" android:inputType="number" />
        <Spinner android:id="@+id/spinnerSubscriptionDurationUnit" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/spinnerSubscriptionFrequency" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Plan item (additional items can be added when editing the offer)" android:textStyle="bold" />
        <Spinner android:id="@+id/spinnerSubscriptionItem" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etSubscriptionItemQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Quantity per delivery" android:inputType="number" />
        <EditText android:id="@+id/etSubscriptionItemPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Admin price per unit" android:inputType="numberDecimal" />
    </LinearLayout>
</ScrollView>
