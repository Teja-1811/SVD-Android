<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginVertical="4dp" app:cardCornerRadius="@dimen/card_corner_radius_medium" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_background" app:strokeWidth="1dp" app:strokeColor="@color/card_stroke_color">
    <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvItemName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Full Cream Milk 120 ML" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_label" android:textStyle="bold" />
                <Spinner android:popupBackground="@drawable/bg_delivery_dropdown" android:id="@+id/spinnerCompany" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:minHeight="48dp"  android:minWidth="48dp" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
            <TextView android:id="@+id/tvCurrentStock" android:layout_width="64dp" android:layout_height="28dp" android:background="@drawable/bg_badge_blue" android:text="93" android:textColor="@color/white" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:gravity="center" />
        </com.svd.svdagencies.utils.CompactLinearLayout>
        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <TextView android:id="@+id/tvPcsCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pcs / crate: 12" android:textColor="@color/textColorSecondary" android:textSize="@dimen/text_size_body_small" />
            <TextView android:id="@+id/tvBuyingPrice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Buying: 10.000" android:textColor="@color/textColorSecondary" android:textSize="@dimen/text_size_body_small" />
        </com.svd.svdagencies.utils.CompactLinearLayout>
        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Crates received" android:textColor="@color/textColorSecondary" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:minHeight="24dp" />
                <EditText style="@style/Widget.Svd.PlainInput" android:id="@+id/etCrates" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_qty_outline" android:gravity="center" android:hint="0" android:inputType="numberDecimal" android:selectAllOnFocus="true" android:text="0" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_body" android:minHeight="@dimen/svd_touch_target" android:padding="8dp"  android:minWidth="48dp" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
            <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Discount" android:textColor="@color/textColorSecondary" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:minHeight="24dp" />
                <EditText style="@style/Widget.Svd.PlainInput" android:id="@+id/etDiscount" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_qty_outline" android:gravity="center" android:hint="0" android:inputType="numberDecimal" android:selectAllOnFocus="true" android:text="0" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_body" android:minHeight="@dimen/svd_touch_target" android:padding="8dp"  android:minWidth="48dp" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </com.svd.svdagencies.utils.CompactLinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Discount: % for Dodla; ₹/piece for others." android:textSize="@dimen/svd_text_caption" android:textColor="@color/textColorSecondary" />
        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <TextView android:id="@+id/tvQuantityPreview" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quantity: 0.000" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_label" android:textStyle="bold" />
            <TextView android:id="@+id/tvValuePreview" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Value: 0.000" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_label" android:textStyle="bold" />
        </com.svd.svdagencies.utils.CompactLinearLayout>
    </com.svd.svdagencies.utils.CompactLinearLayout>
</com.google.android.material.card.MaterialCardView>