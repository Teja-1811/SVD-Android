<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            layout="@layout/admin_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.svd.svdagencies.utils.AppSwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <!-- Customers -->
                        <include
                            android:id="@+id/cardCustomers"
                            layout="@layout/admin_stat_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/spacing_small" />

                        <!-- Items -->
                        <include
                            android:id="@+id/cardItems"
                            layout="@layout/admin_stat_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/spacing_small" />

                        <!-- Sales Today -->
                        <include
                            android:id="@+id/cardSales"
                            layout="@layout/admin_stat_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/spacing_small" />

                        <!-- Dues -->
                        <include
                            android:id="@+id/cardDues"
                            layout="@layout/admin_stat_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/spacing_small" />

                    </GridLayout>

                    <!-- Update Stock Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdateStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_small"
                        android:text="Update Stock"
                        android:textAllCaps="false"
                        android:padding="@dimen/spacing_medium"
                        app:cornerRadius="@dimen/spacing_medium"
                        app:icon="@drawable/ic_items"
                        app:backgroundTint="@color/brand_red"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_button"
                        android:textStyle="bold"/>

                    <!-- Pending Orders -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_small"
                        app:cardCornerRadius="@dimen/spacing_large"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/card_stroke_color"
                        app:cardBackgroundColor="@color/card_background">

                        <LinearLayout
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_large"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_orders"
                                app:tint="@color/brand_red"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Pending Orders"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="@dimen/text_size_medium"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvPendingOrders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="@dimen/text_size_large"
                                android:textStyle="bold"
                                android:layout_marginEnd="@dimen/spacing_large"/>

                            <ImageButton
                                android:id="@+id/btnViewOrders"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_eye"
                                app:tint="@color/brand_red"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Not Ordered Today -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_small"
                        app:cardCornerRadius="@dimen/spacing_large"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/card_stroke_color"
                        app:cardBackgroundColor="@color/card_background">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/spacing_large">

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_orders"
                                    app:tint="@color/brand_red"
                                    android:rotation="180"/>

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Not Ordered Today"
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="@dimen/text_size_medium"
                                    android:layout_marginStart="@dimen/spacing_medium"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:id="@+id/tvNotOrdered"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/textColorPrimary"
                                    android:textStyle="bold"
                                    android:textSize="@dimen/text_size_large"/>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="@dimen/spacing_medium"
                                android:layout_marginBottom="@dimen/spacing_small"
                                android:background="@color/divider_line" />

                            <LinearLayout
                                android:id="@+id/layoutNoOrdersList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <!-- Dynamic rows -->
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </ScrollView>
        </com.svd.svdagencies.utils.AppSwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:layout_gravity="start"
        app:headerLayout="@layout/admin_nav_header"
        app:itemIconTint="@color/drawer_nav_icon_colors"
        app:itemTextColor="@color/drawer_nav_item_colors"
        app:menu="@menu/menu_admin_drawer"/>

</androidx.drawerlayout.widget.DrawerLayout>
