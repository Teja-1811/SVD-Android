<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/window_background">
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <include layout="@layout/admin_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
        <com.svd.svdagencies.utils.AppSwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
            <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xlarge">
                    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_portal_hero">
                        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MILK AGENCY"
        android:textSize="@dimen/svd_text_caption"
        android:textColor="?attr/colorPrimary"
        android:layout_marginTop="4dp"
        android:textStyle="bold" />
                        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Business overview"
        android:textSize="@dimen/svd_text_title"
        android:textColor="@color/textColorPrimary"
        android:layout_marginTop="4dp"
        android:textStyle="bold" />
                        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sales, accounts and daily operations."
        android:textSize="@dimen/svd_text_label"
        android:textColor="@color/textColorSecondary"
        android:layout_marginTop="4dp"  android:visibility="gone" />
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/grid_16"
        android:alignmentMode="alignMargins"
        android:columnCount="@integer/svd_summary_columns"
        android:columnOrderPreserved="false"
        android:useDefaultMargins="false">
                        <include
        android:id="@+id/cardCustomers" layout="@layout/admin_stat_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginEnd="@dimen/grid_8"
        android:layout_marginBottom="@dimen/grid_16" />
                        <include
        android:id="@+id/cardItems" layout="@layout/admin_stat_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginStart="@dimen/grid_8"
        android:layout_marginBottom="@dimen/grid_16" />
                        <include
        android:id="@+id/cardSales" layout="@layout/admin_stat_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginEnd="@dimen/grid_8"
        android:layout_marginBottom="@dimen/grid_16" />
                        <include
        android:id="@+id/cardDues" layout="@layout/admin_stat_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginStart="@dimen/grid_8"
        android:layout_marginBottom="@dimen/grid_16" />
                        <include
        android:id="@+id/cardProfit" layout="@layout/admin_stat_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginEnd="@dimen/grid_8"
        android:layout_marginBottom="@dimen/grid_16" />
                        <include
        android:id="@+id/cardStockValue" layout="@layout/admin_stat_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginStart="@dimen/grid_8"
        android:layout_marginBottom="@dimen/grid_16" />
                    </GridLayout>
                    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grid_16"
        android:orientation="horizontal"
        android:weightSum="2">
                        <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpdateStock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/grid_4"
        android:backgroundTint="?attr/colorPrimary"
        android:text="@string/button_update_stock"
        android:textAllCaps="false"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/ic_stock"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/grid_8"
        app:iconTint="?attr/colorOnPrimary"  android:minHeight="@dimen/svd_touch_target"  android:minWidth="48dp" />
                        <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStatement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/grid_4"
        android:backgroundTint="@color/brand_blue"
        android:text="@string/button_statement"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/ic_bill"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/grid_8"
        app:iconTint="@color/white"  android:minHeight="@dimen/svd_touch_target"  android:minWidth="48dp" />
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grid_8"
        android:text="@string/title_daily_operations"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold" />
                    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grid_12"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_large">
                                <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_light_gray"
        android:padding="@dimen/spacing_small"
        android:src="@drawable/ic_orders"
        app:tint="?attr/colorPrimary" />
                                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_weight="1"
        android:orientation="vertical">
                                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_pending_orders"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_small" />
                                    <TextView
        android:id="@+id/tvPendingOrders"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:text="0"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/text_size_xxlarge"
        android:textStyle="bold" />
                                </com.svd.svdagencies.utils.CompactLinearLayout>
                                <ImageButton
        android:id="@+id/btnViewOrders"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/view_orders"
        android:src="@drawable/ic_eye"
        app:tint="?attr/colorPrimary" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutPendingOrdersList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_large"
        android:visibility="gone"
        tools:visibility="visible" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grid_12"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_large">
                                <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_light_gray"
        android:padding="@dimen/spacing_small"
        android:src="@drawable/ic_person"
        app:tint="?attr/colorPrimary" />
                                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_weight="1"
        android:orientation="vertical">
                                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_customer_enquiries"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_small" />
                                    <TextView
        android:id="@+id/tvEnquiries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:text="0"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/text_size_xxlarge"
        android:textStyle="bold" />
                                </com.svd.svdagencies.utils.CompactLinearLayout>
                                <ImageButton
        android:id="@+id/btnViewEnquiries"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_eye"
        app:tint="?attr/colorPrimary" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutEnquiriesList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_large"
        android:visibility="gone"
        tools:visibility="visible" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/grid_12"
        android:layout_marginBottom="@dimen/grid_8"
        android:text="Top Selling Items Today"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold" />
                    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grid_16"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutTopSellingList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/grid_12"
        android:layout_marginBottom="@dimen/grid_8"
        android:text="Active Offers"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold" />
                    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grid_16"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutActiveOffersList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/grid_12"
        android:layout_marginBottom="@dimen/grid_8"
        android:text="@string/title_top_due_customers"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold" />
                    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grid_16"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutTopDuesList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/grid_12"
        android:layout_marginBottom="@dimen/grid_8"
        android:text="@string/title_top_stock_items"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold" />
                    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grid_16"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutTopStockList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large" />
                    </com.google.android.material.card.MaterialCardView>
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.svd.svdagencies.utils.AppSwipeRefreshLayout>
    </com.svd.svdagencies.utils.CompactLinearLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        app:headerLayout="@layout/admin_nav_header"
        app:itemIconTint="@color/drawer_nav_icon_colors"
        app:itemTextColor="@color/drawer_nav_item_colors"
        app:menu="@menu/menu_admin_drawer"
        app:backgroundTint="?attr/colorSurface" />
</androidx.drawerlayout.widget.DrawerLayout>
