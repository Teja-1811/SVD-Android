<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            layout="@layout/admin_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.svd.svdagencies.utils.AppSwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_large"
                    android:paddingTop="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_large"
                    android:paddingBottom="@dimen/spacing_xlarge">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dashboard"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="@dimen/text_size_xxlarge"
                        android:textStyle="bold" />


                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_16"
                        android:alignmentMode="alignMargins"
                        android:columnCount="2"
                        android:columnOrderPreserved="false"
                        android:useDefaultMargins="false">

                        <include
                            android:id="@+id/cardCustomers"
                            layout="@layout/admin_stat_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginEnd="@dimen/grid_8"
                            android:layout_marginBottom="@dimen/grid_16" />

                        <include
                            android:id="@+id/cardItems"
                            layout="@layout/admin_stat_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="@dimen/grid_8"
                            android:layout_marginBottom="@dimen/grid_16" />

                        <include
                            android:id="@+id/cardSales"
                            layout="@layout/admin_stat_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginEnd="@dimen/grid_8"
                            android:layout_marginBottom="@dimen/grid_16" />

                        <include
                            android:id="@+id/cardDues"
                            layout="@layout/admin_stat_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="@dimen/grid_8"
                            android:layout_marginBottom="@dimen/grid_16" />
                    </GridLayout>



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/grid_16"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdateStock"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/grid_4"
                            android:backgroundTint="@color/brand_red"
                            android:text="Update Stock"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            app:cornerRadius="@dimen/button_corner_radius"
                            app:icon="@drawable/ic_stock"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/grid_8"
                            app:iconTint="@color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStatement"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/grid_4"
                            android:backgroundTint="@color/brand_blue"
                            android:text="Statement"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            app:cornerRadius="@dimen/button_corner_radius"
                            app:icon="@drawable/ic_bill"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/grid_8"
                            app:iconTint="@color/white" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/grid_8"
                        android:text="Daily Operations"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/grid_12"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="@dimen/card_corner_radius_medium"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/card_background"
                            android:gravity="center_vertical"
                            android:minHeight="76dp"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_large">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_light_gray"
                                android:padding="@dimen/spacing_small"
                                android:src="@drawable/ic_orders"
                                app:tint="@color/brand_red" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pending Orders"
                                    android:textColor="@color/textColorSecondary"
                                    android:textSize="@dimen/text_size_small" />

                                <TextView
                                    android:id="@+id/tvPendingOrders"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_tiny"
                                    android:text="0"
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="@dimen/text_size_xxlarge"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/btnViewOrders"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/view_orders"
                                android:src="@drawable/ic_eye"
                                app:tint="@color/brand_red" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/grid_12"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="@dimen/card_corner_radius_medium"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/card_background"
                            android:gravity="center_vertical"
                            android:minHeight="76dp"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_large">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_light_gray"
                                android:padding="@dimen/spacing_small"
                                android:src="@drawable/ic_person"
                                app:tint="@color/brand_red" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Customer Enquiries"
                                    android:textColor="@color/textColorSecondary"
                                    android:textSize="@dimen/text_size_small" />

                                <TextView
                                    android:id="@+id/tvEnquiries"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_tiny"
                                    android:text="0"
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="@dimen/text_size_xxlarge"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/btnViewEnquiries"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_eye"
                                app:tint="@color/brand_red" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/grid_16"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="@dimen/card_corner_radius_medium"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/card_background"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_large">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_light_gray"
                                    android:padding="@dimen/spacing_small"
                                    android:rotation="180"
                                    android:src="@drawable/ic_orders"
                                    app:tint="@color/textColorSecondary" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_medium"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Customers Not Ordered"
                                        android:textColor="@color/textColorSecondary"
                                        android:textSize="@dimen/text_size_small" />

                                    <TextView
                                        android:id="@+id/tvNotOrdered"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/spacing_tiny"
                                        android:text="0"
                                        android:textColor="@color/textColorPrimary"
                                        android:textSize="@dimen/text_size_xxlarge"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="@dimen/spacing_large"
                                android:layout_marginBottom="@dimen/spacing_small"
                                android:background="@color/divider_line" />

                            <LinearLayout
                                android:id="@+id/layoutNoOrdersList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                tools:ignore="UselessLeaf" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_12"
                        android:layout_marginBottom="@dimen/grid_8"
                        android:text="Top Due Customers"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/grid_16"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="@dimen/card_corner_radius_medium"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/layoutTopDuesList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_large" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_12"
                        android:layout_marginBottom="@dimen/grid_8"
                        android:text="Top Stock Items"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/grid_16"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="@dimen/card_corner_radius_medium"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/layoutTopStockList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_large" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.svd.svdagencies.utils.AppSwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/card_background"
        app:headerLayout="@layout/admin_nav_header"
        app:itemIconTint="@color/drawer_nav_icon_colors"
        app:itemTextColor="@color/drawer_nav_item_colors"
        app:menu="@menu/menu_admin_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
