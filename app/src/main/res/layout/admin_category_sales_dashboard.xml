<?xml version='1.0' encoding='utf-8'?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/window_background">
    <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include layout="@layout/admin_toolbar" />
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
                <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Understand your sales" android:textSize="@dimen/svd_text_heading" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:visibility="gone" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:text="See billed sales and volume for each product category." android:textSize="@dimen/svd_text_label" android:textColor="@color/textColorSecondary" android:visibility="gone" />
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/card_background" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/card_stroke_color" app:strokeWidth="1dp">
                        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                            <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="bottom" android:tag="svd-fixed-row">
                                <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginEnd="8dp">
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Period" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:labelFor="@id/spinnerPeriod" />
                                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_category_sales_filter">
                                        <Spinner android:id="@+id/spinnerPeriod" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/svd_touch_target" android:minWidth="48dp" android:paddingStart="32dp" android:paddingEnd="32dp" android:contentDescription="Sales period" android:background="@null" android:popupBackground="@drawable/bg_category_sales_filter" />
                                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="12dp" android:src="@drawable/ic_expand" app:tint="?attr/colorPrimary" android:importantForAccessibility="no" />
                                    </FrameLayout>
                                </com.svd.svdagencies.utils.CompactLinearLayout>
                                <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginEnd="0dp">
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Date" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:labelFor="@id/btnSelectSalesDate" />
                                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSelectSalesDate" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose date" android:textAllCaps="false" android:minWidth="48dp" android:minHeight="@dimen/svd_touch_target" android:paddingHorizontal="16dp" android:paddingVertical="10dp" android:gravity="start|center_vertical" android:textColor="?attr/colorPrimary" app:strokeColor="@color/card_stroke_color" app:cornerRadius="16dp" app:icon="@drawable/ic_calendar" app:iconTint="?attr/colorPrimary" app:iconGravity="start" app:iconPadding="12dp" />
                                </com.svd.svdagencies.utils.CompactLinearLayout>
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <TextView android:id="@+id/tvSalesFilterHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/textColorSecondary" android:textSize="@dimen/svd_text_label" android:visibility="gone" />
                            <TextView android:id="@+id/tvAppliedSalesRange" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="12dp" android:background="@drawable/bg_stock_date_field" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_label" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.svd.svdagencies.utils.CompactLinearLayout android:id="@+id/categorySalesContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:accessibilityLiveRegion="polite" />
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </ScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </com.svd.svdagencies.utils.CompactLinearLayout>
    <com.google.android.material.navigation.NavigationView android:id="@+id/navigationView" android:layout_width="300dp" android:layout_height="match_parent" android:layout_gravity="start" app:headerLayout="@layout/admin_nav_header" app:menu="@menu/menu_admin_drawer" android:background="?attr/colorSurface" app:backgroundTint="?attr/colorSurface" />
</androidx.drawerlayout.widget.DrawerLayout>