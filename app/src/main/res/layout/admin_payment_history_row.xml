<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_variant"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Customer" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:textColor="@color/textColorPrimary" />
        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Amount" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:gravity="center" android:textColor="@color/textColorPrimary" />
        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Method" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:gravity="center" android:textColor="@color/textColorPrimary" />
        <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="Transaction" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:gravity="center" android:textColor="@color/textColorPrimary" />
        <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="Date" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:gravity="center" android:textColor="@color/textColorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView android:id="@+id/tvCustomerName" android:layout_width="140dp" android:layout_height="wrap_content" android:text="Name" android:textSize="@dimen/text_size_body_small" android:textColor="@color/textColorPrimary" />
        <TextView android:id="@+id/tvAmount" android:layout_width="80dp" android:layout_height="wrap_content" android:text="Rs. 0" android:textSize="@dimen/text_size_body_small" android:gravity="center" android:textColor="@color/icon_green" android:textStyle="bold" />
        <TextView android:id="@+id/tvMethod" android:layout_width="80dp" android:layout_height="wrap_content" android:text="UPI" android:textSize="@dimen/text_size_body_small" android:gravity="center" android:textColor="@color/textColorPrimary" />
        <TextView android:id="@+id/tvTxnId" android:layout_width="120dp" android:layout_height="wrap_content" android:text="TXN123" android:textSize="@dimen/text_size_body_small" android:gravity="center" android:textColor="@color/textColorPrimary" />
        <TextView android:id="@+id/tvDate" android:layout_width="120dp" android:layout_height="wrap_content" android:text="Date" android:textSize="@dimen/text_size_body_small" android:gravity="center" android:textColor="@color/textColorPrimary" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_line" />
</LinearLayout>
