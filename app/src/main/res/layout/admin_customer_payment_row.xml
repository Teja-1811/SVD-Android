<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginVertical="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/card_corner_radius_medium"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_stroke_color"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- HEADER: Customer and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Name"
                    android:textStyle="bold"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="@dimen/text_size_small"
                    tools:text="Satyavathi"/>

                <TextView
                    android:id="@+id/tvCustomerPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8886307827"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    tools:text="8886307827"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft_badge"
                android:paddingHorizontal="@dimen/spacing_small"
                android:paddingVertical="2dp"
                android:text="success"
                android:textAllCaps="true"
                android:textColor="#00695C"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:backgroundTint="#E0F2F1"
                tools:text="SUCCESS" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_line"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_small"
            android:alpha="0.5"/>

        <!-- INFO ROWS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Transaction ID: "
                android:textStyle="bold"
                android:textColor="@color/textColorPrimary"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvTxnId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAY-000000"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                tools:text="PAY-BDF2C97502"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Method: "
                android:textStyle="bold"
                android:textColor="@color/textColorPrimary"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASH"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                tools:text="CASH"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Amount: "
                android:textStyle="bold"
                android:textColor="@color/brand_blue"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textStyle="bold"
                android:textColor="@color/brand_blue"
                android:textSize="12sp"
                tools:text="₹2000.00"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Date: "
                android:textStyle="bold"
                android:textColor="@color/textColorPrimary"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jan 01, 2024"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                tools:text="11 May 2026"/>
        </LinearLayout>

        <!-- Hidden tvStatus for binding compatibility -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_medium">

            <!-- WhatsApp -->
            <ImageButton
                android:id="@+id/btnWhatsApp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_whatsapp"
                app:tint="@color/icon_green"
                android:background="@drawable/bg_outline_green"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"/>

            <Space android:layout_width="@dimen/spacing_small" android:layout_height="wrap_content"/>

            <!-- Edit Status (for non-pending) -->
            <ImageButton
                android:id="@+id/btnEditStatus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/brand_blue"
                android:background="@drawable/bg_outline_blue"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"
                android:visibility="gone"/>

            <!-- Mark Success (for pending) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkSuccess"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:text="Success"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="4dp"
                app:backgroundTint="@color/icon_green"
                android:textColor="@color/white"
                android:visibility="gone"/>

            <Space
                android:id="@+id/spaceSuccessFailure"
                android:layout_width="@dimen/spacing_small"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <!-- Mark Failure (for pending) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkFailure"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:text="Failure"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="4dp"
                app:backgroundTint="@color/brand_red"
                android:textColor="@color/white"
                android:visibility="gone"/>

            <!-- For adapter logic compatibility, adding a hidden space -->
            <Space
                android:id="@+id/spaceFailureEdit"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <!-- Delete -->
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_trash"
                app:tint="@color/brand_red"
                android:background="@drawable/bg_outline_red"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"/>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
