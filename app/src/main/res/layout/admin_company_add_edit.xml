<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/window_background">
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <include layout="@layout/admin_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
        <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
                <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fill the form to save company details"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small"
        android:layout_marginBottom="16dp"  android:visibility="gone" />
                <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke_color"
        app:cardBackgroundColor="@color/card_background"
        android:layout_marginBottom="16dp">
                    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/svd_space_section">
                            <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_shop"
        app:tint="@color/brand_blue"
        android:layout_marginEnd="8dp" />
                            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Company Details"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_label" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="@dimen/svd_space_section">
                            <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:cardCornerRadius="@dimen/card_corner_radius_small"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke_color">
                                <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:src="@drawable/ic_milk_placeholder" />
                            </com.google.android.material.card.MaterialCardView>
                            <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectLogo" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Logo"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/brand_blue"  android:minHeight="48dp"  android:minWidth="48dp" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Company Name *"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="6dp" />
                        <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etCompanyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="e.g. Heritage, Dodla"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="textCapWords"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"  android:minWidth="48dp" />
                        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Website Link"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="6dp" />
                        <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etWebsite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="https://example.com"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="textUri"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/window_background"
        android:elevation="0dp"
        android:gravity="end">
            <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textSize="@dimen/text_size_body_small"
        android:textAllCaps="false"
        android:textColor="@color/textColorSecondary"
        app:strokeColor="@color/gray500"
        android:layout_marginEnd="16dp"  android:minHeight="48dp"  android:minWidth="48dp" />
            <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Company"
        android:textSize="@dimen/text_size_body_small"
        android:textAllCaps="false"
        app:cornerRadius="8dp"
        app:backgroundTint="?attr/colorPrimary"  android:minHeight="48dp"  android:minWidth="48dp" />
        </com.svd.svdagencies.utils.CompactLinearLayout>
    </com.svd.svdagencies.utils.CompactLinearLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:layout_gravity="start"
        app:headerLayout="@layout/admin_nav_header"
        app:itemIconTint="@color/drawer_nav_icon_colors"
        app:itemTextColor="@color/drawer_nav_item_colors"
        app:menu="@menu/menu_admin_drawer"
        app:backgroundTint="?attr/colorSurface" />
</androidx.drawerlayout.widget.DrawerLayout>
