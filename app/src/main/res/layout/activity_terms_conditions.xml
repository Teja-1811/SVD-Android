<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:padding="16dp"
        android:clipToPadding="false" android:fillViewport="true">
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.google.android.material.card.MaterialCardView style="@style/Widget.App.CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke_color">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Terms &amp; Conditions"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="Please read our operating policies regarding payments, orders, and service usage."
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/svd_text_label"  android:visibility="gone" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.App.CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke_color">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
                <TextView
        android:id="@+id/sectionOperator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableEnd="@drawable/ic_expand"
        android:drawablePadding="8dp"
        android:text="1. Services &amp; Responsibilities"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/operatorContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone">
                    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="8dp"
        android:text="• Usage: Using this app implies acceptance of all terms.\n• Scope: We provide milk subscriptions and product supply.\n• Security: You are responsible for account confidentiality.\n• Contact: Reach us via the Support section for any issues."
        android:textColor="@color/text_primary"
        android:textSize="@dimen/svd_text_label" />
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.App.CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke_color">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
                <TextView
        android:id="@+id/sectionOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableEnd="@drawable/ic_expand"
        android:drawablePadding="8dp"
        android:text="2. Payments, Orders &amp; Refunds"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/ordersContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone">
                    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:letterSpacing="0.1"
        android:text="PAYMENTS"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:lineSpacingExtra="8dp"
        android:text="• Methods: UPI, debit or credit cards, and net banking.\n• Fee: Credit cards may incur a 1.5-2% + GST fee.\n• Timing: Bank updates may take 1-3 business days.\n• Activation: Services start after payment confirmation."
        android:textColor="@color/text_primary"
        android:textSize="@dimen/svd_text_label" />
                    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:letterSpacing="0.1"
        android:text="REFUNDS &amp; CANCELLATIONS"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="8dp"
        android:text="• Eligibility: Only for failed payments or service errors.\n• Processing: Valid refunds take 5-10 business days.\n• Orders: No modifications once system-confirmed.\n• Disputes: Report payment issues within 7 days."
        android:textColor="@color/text_primary"
        android:textSize="@dimen/svd_text_label" />
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.svd.svdagencies.utils.CompactLinearLayout>
</ScrollView>
