<?xml version='1.0' encoding='utf-8'?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_background">
    <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include layout="@layout/admin_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:scrollbars="none" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
            <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/svd_space_section">
                <TextView android:id="@+id/tvHeaderTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add New Expense" android:textSize="@dimen/svd_text_heading" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_marginBottom="@dimen/svd_space_section" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="@dimen/card_corner_radius_medium" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/card_stroke_color" app:cardBackgroundColor="@color/card_background">
                    <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/svd_space_section">
                        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="bottom" android:tag="svd-fixed-row" android:layout_marginBottom="16dp">
                            <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginEnd="8dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Date" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_label" android:layout_marginBottom="8dp" android:layout_marginTop="0dp" />
                                <EditText style="@style/Widget.Svd.PlainInput" android:id="@+id/etDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="yyyy-mm-dd" android:inputType="none" android:focusable="false" android:clickable="true" android:background="@drawable/bg_qty_outline" android:backgroundTint="@color/bg_light_gray" android:padding="14dp" android:textSize="@dimen/svd_text_body" android:textColor="@color/textColorPrimary" android:minHeight="48dp" android:minWidth="48dp" android:layout_marginTop="0dp" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginEnd="0dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Category" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_label" android:layout_marginTop="0dp" android:layout_marginBottom="8dp" />
                                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" app:boxStrokeColor="?attr/colorPrimary" app:hintEnabled="false" app:boxBackgroundColor="@color/editTextBackground" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginTop="0dp">
                                    <AutoCompleteTextView style="@style/Widget.Svd.PlainInput" android:popupBackground="@drawable/bg_delivery_dropdown" android:id="@+id/spinnerCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:hint="Select Category" android:textColor="@color/textColorPrimary" android:padding="14dp" android:minHeight="48dp" android:minWidth="48dp" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amount (₹)" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_label" android:layout_marginBottom="8dp" />
                        <EditText style="@style/Widget.Svd.PlainInput" android:id="@+id/etAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="0.00" android:inputType="numberDecimal" android:imeOptions="actionDone" android:background="@drawable/bg_qty_outline" android:backgroundTint="@color/bg_light_gray" android:padding="14dp" android:textSize="@dimen/svd_text_body" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:minHeight="48dp" android:minWidth="48dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Description (Optional)" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:textSize="@dimen/svd_text_label" android:layout_marginTop="@dimen/svd_space_section" android:layout_marginBottom="8dp" />
                        <EditText style="@style/Widget.Svd.PlainInput" android:id="@+id/etDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Optional note about this expense" android:inputType="textMultiLine" android:minLines="3" android:gravity="top" android:background="@drawable/bg_qty_outline" android:backgroundTint="@color/bg_light_gray" android:textColor="@color/textColorPrimary" android:padding="14dp" android:textSize="@dimen/svd_text_body" android:minHeight="48dp" android:minWidth="48dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveExpense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Save Expense" android:textStyle="bold" android:textSize="@dimen/svd_text_body" app:cornerRadius="12dp" android:textColor="?attr/colorOnPrimary" app:backgroundTint="?attr/colorPrimary" android:minHeight="@dimen/svd_touch_target" android:minWidth="48dp" />
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </ScrollView>
    </com.svd.svdagencies.utils.CompactLinearLayout>
    <com.google.android.material.navigation.NavigationView android:id="@+id/navigationView" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="?attr/colorSurface" android:layout_gravity="start" app:headerLayout="@layout/admin_nav_header" app:itemIconTint="@color/drawer_nav_icon_colors" app:itemTextColor="@color/drawer_nav_item_colors" app:menu="@menu/menu_admin_drawer" app:backgroundTint="?attr/colorSurface" />
</androidx.drawerlayout.widget.DrawerLayout>