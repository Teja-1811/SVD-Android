<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/admin_toolbar" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddExpense"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Add Expense"
                            android:textAllCaps="false"
                            app:backgroundTint="#FFC107"
                            android:textColor="@color/black"
                            android:layout_marginEnd="12dp"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_plus"
                            app:iconTint="@color/black"
                            app:iconSize="18dp"
                            app:iconGravity="textStart"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewExpenses"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Expenses"
                            android:textAllCaps="false"
                            app:backgroundTint="#00BCD4"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_menu"
                            app:iconSize="18dp"
                            app:iconTint="@color/white"
                            app:iconGravity="textStart"/>
                    </LinearLayout>

                    <!-- Filter Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:layout_marginEnd="6dp"
                            app:hintEnabled="false"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxBackgroundColor="@color/white"
                            app:boxStrokeColor="@color/divider_line">

                            <AutoCompleteTextView
                                android:id="@+id/spinnerMonth"
                                android:layout_width="match_parent"
                                android:layout_height="42dp"
                                android:inputType="none"
                                android:text="February"
                                android:textSize="12sp"
                                android:paddingStart="10dp"
                                android:paddingEnd="32dp"
                                android:gravity="center_vertical"
                                android:background="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:hintEnabled="false"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxBackgroundColor="@color/white"
                            app:boxStrokeColor="@color/divider_line">

                            <AutoCompleteTextView
                                android:id="@+id/spinnerYear"
                                android:layout_width="match_parent"
                                android:layout_height="42dp"
                                android:inputType="none"
                                android:text="2025"
                                android:textSize="12sp"
                                android:paddingStart="10dp"
                                android:paddingEnd="32dp"
                                android:gravity="center_vertical"
                                android:background="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnApplyFilters"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:padding="0dp"
                            app:backgroundTint="#2962FF"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_search"
                            app:iconSize="20dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp" />

                        <ImageButton
                            android:id="@+id/btnResetFilters"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_close"
                            app:tint="@color/textColorSecondary"
                            android:padding="6dp"
                            android:scaleType="fitCenter"/>
                    </LinearLayout>

                    <!-- Stats Grid -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alignmentMode="alignMargins"
                        android:columnCount="2"
                        android:columnOrderPreserved="false">

                        <include android:id="@+id/statCash" layout="@layout/admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                        <include android:id="@+id/statBank" layout="@layout/admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                        <include android:id="@+id/statDues" layout="@layout/admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                        <include android:id="@+id/statNetCash" layout="@layout/admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                        <include android:id="@+id/statExpenses" layout="@layout/admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                        <include android:id="@+id/statProfit" layout="@layout/admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                        <include android:id="@+id/statStockValue" layout="@layout/admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                        <include android:id="@+id/statRAmount" layout="@layout/admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                        <include android:id="@+id/statNetProfit" layout="@layout/admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>

                    </GridLayout>

                    <!-- Company Dues Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Company Dues"
                        android:textColor="#FFC107"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Indicators (Dots) -->
                    <LinearLayout
                        android:id="@+id/layoutDuesIndicators"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"/>

                    <!-- Horizontal Sliding Cards -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCompanyDues"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/admin_cashbook_company_due"
                        android:clipToPadding="false" />

                    <TextView
                        android:id="@+id/tvTotalCompanyDues"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Dues: ₹0.00"
                        android:textColor="#D32F2F"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="13sp"/>

                    <!-- Bank Balance Update -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E0E0E0">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bank Balance"
                                android:textColor="#00BCD4"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_marginBottom="16dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <EditText
                                    android:id="@+id/etBankBalance"
                                    android:layout_width="0dp"
                                    android:layout_height="52dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_edit_text"
                                    android:hint="e.g. 5697.27"
                                    android:inputType="numberDecimal"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnUpdateBank"
                                    android:layout_width="wrap_content"
                                    android:layout_height="52dp"
                                    android:text="Update"
                                    android:textAllCaps="false"
                                    app:backgroundTint="#00BCD4"
                                    android:layout_marginStart="12dp"
                                    android:textStyle="bold"
                                    android:textSize="12sp"
                                    app:cornerRadius="12dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Cash In / Denominations -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E0E0E0">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cash In Counter"
                                android:textColor="#2196F3"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_marginBottom="16dp"/>

                             <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notes"
                                android:textColor="#2196F3"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp"/>

                            <GridLayout
                                android:id="@+id/gridNotes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:columnCount="3"
                                android:alignmentMode="alignMargins"
                                android:columnOrderPreserved="false">
                                <!-- Dynamically filled in code -->
                            </GridLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnUpdateCashIn"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:text="Save Cash Counts"
                                android:textAllCaps="false"
                                app:backgroundTint="#2196F3"
                                android:layout_marginTop="24dp"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_save"
                                app:iconGravity="textStart"
                                app:iconSize="20dp"/>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/admin_nav_header"
        app:menu="@menu/menu_admin_drawer"/>

</androidx.drawerlayout.widget.DrawerLayout>