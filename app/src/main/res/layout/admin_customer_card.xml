<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/card_corner_radius_large"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke_color"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white">

    <!-- Container for Blue Bar + Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Blue Stroke Indicator -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/icon_blue" />

        <!-- Main Content -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_large"
            android:paddingTop="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_medium">

            <!-- ================= TOP ROW: Name ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtCustomerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2. N Satyavathi"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtShopName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shop Name"
                android:textColor="@color/textColorSecondary"
                android:textSize="@dimen/text_size_caption"
                android:ellipsize="end"
                android:maxLines="1"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_line"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <!-- ================= MIDDLE ROW: Details ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <!-- LEFT INFO COLUMN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Balance -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_tiny">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Balance: "
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_size_caption"/>

                        <TextView
                            android:id="@+id/txtBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹ 8.00"
                            android:textColor="@color/brand_red"
                            android:textSize="@dimen/text_size_body_small"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Phone -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone: "
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_size_caption"/>

                        <TextView
                            android:id="@+id/txtPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8886307827"
                            android:textColor="@color/textColorSecondary"
                            android:textSize="@dimen/text_size_caption"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- RIGHT ACTION BUTTONS -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- View / Eye Button -->
                    <ImageView
                        android:id="@+id/btnView"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_eye"
                        android:background="@drawable/bg_icon_btn"
                        app:tint="@color/icon_blue"
                        android:layout_marginEnd="@dimen/spacing_small"/>

                    <!-- Lock / Password Button -->
                    <ImageView
                        android:id="@+id/btnPassword"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_lock"
                        android:background="@drawable/bg_icon_btn_gray"
                        app:tint="@color/icon_gray_btn"
                        android:layout_marginEnd="@dimen/spacing_small"/>

                    <!-- WhatsApp Button -->
                    <ImageView
                        android:id="@+id/btnWhatsapp"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_whatsapp"
                        android:background="@drawable/bg_icon_btn_green"
                        app:tint="#25D366"
                        android:layout_marginEnd="@dimen/spacing_small"/>

                    <!-- Pay Button -->
                    <ImageView
                        android:id="@+id/btnPay"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_rupee"
                        android:background="@drawable/bg_icon_btn"
                        app:tint="@color/icon_blue"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>