<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke_color"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- HEADER: Bill # and Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBillNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bill #INV-000000"
                android:textStyle="bold"
                android:textColor="@color/textColorPrimary"
                android:textSize="@dimen/text_size_small"/>

            <TextView
                android:id="@+id/tvBillDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jan 01, 2024"
                android:background="@drawable/bg_qty_outline"
                android:backgroundTint="@color/editTextBackground"
                android:textColor="@color/textColorPrimary"
                android:paddingStart="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Customer Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_tiny">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer: "
                android:textStyle="bold"
                android:textColor="@color/textColorPrimary"
                android:textSize="@dimen/text_size_small"/>

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textColor="@color/textColorSecondary"
                android:textSize="@dimen/text_size_small"/>
        </LinearLayout>

        <!-- Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_tiny">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: "
                android:textStyle="bold"
                android:textColor="@color/brand_blue"
                android:textSize="@dimen/text_size_small"/>

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textStyle="bold"
                android:textColor="@color/brand_blue"
                android:textSize="@dimen/text_size_small"/>
        </LinearLayout>

        <!-- Profit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_tiny">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profit: "
                android:textStyle="bold"
                android:textColor="@color/icon_green"
                android:textSize="@dimen/text_size_small"/>

            <TextView
                android:id="@+id/tvProfitAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textStyle="bold"
                android:textColor="@color/icon_green"
                android:textSize="@dimen/text_size_small"/>
        </LinearLayout>

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_medium">

            <!-- View Button -->
            <ImageButton
                android:id="@+id/btnView"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_eye"
                app:tint="@color/brand_blue"
                android:background="@drawable/bg_outline_blue"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"/>

            <Space android:layout_width="@dimen/spacing_small" android:layout_height="wrap_content"/>

            <!-- Edit Button -->
            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/icon_orange"
                android:background="@drawable/bg_outline_orange"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"/>

            <Space android:layout_width="@dimen/spacing_small" android:layout_height="wrap_content"/>

            <!-- WhatsApp Share Button -->
            <ImageButton
                android:id="@+id/btnWhatsapp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_whatsapp"
                app:tint="@color/icon_green"
                android:background="@drawable/bg_outline_green"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"/>

            <Space android:layout_width="@dimen/spacing_small" android:layout_height="wrap_content"/>

            <!-- Download Button -->
            <ImageButton
                android:id="@+id/btnDownload"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_download"
                app:tint="@color/brand_blue"
                android:background="@drawable/bg_outline_blue"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"/>

            <Space android:layout_width="@dimen/spacing_small" android:layout_height="wrap_content"/>

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_trash"
                app:tint="@color/brand_red"
                android:background="@drawable/bg_outline_red"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
