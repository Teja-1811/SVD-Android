<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/card_corner_radius_medium"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke_color"
    app:strokeWidth="1dp">

    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.svd.svdagencies.utils.CompactLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivItem"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_milk_placeholder"
                android:padding="2dp" />

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Fresh Milk 500ml"
                android:textColor="@color/textColorPrimary"
                android:textSize="@dimen/svd_text_label"
                android:textStyle="bold" />
        </com.svd.svdagencies.utils.CompactLinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/divider_line" />

        <!-- Entry/Return Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="@integer/svd_summary_columns"
            android:rowCount="2">

            <!-- Morning -->
            <com.svd.svdagencies.utils.CompactLinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mng Entry"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/tvMngEntry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/brand_blue"
                    android:textSize="@dimen/svd_text_label"
                    android:textStyle="bold" />
            </com.svd.svdagencies.utils.CompactLinearLayout>

            <com.svd.svdagencies.utils.CompactLinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mng Return"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/tvMngReturn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/svd_text_label"
                    android:textStyle="bold" />
            </com.svd.svdagencies.utils.CompactLinearLayout>

            <!-- Evening -->
            <com.svd.svdagencies.utils.CompactLinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eve Entry"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/tvEveEntry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/brand_blue"
                    android:textSize="@dimen/svd_text_label"
                    android:textStyle="bold" />
            </com.svd.svdagencies.utils.CompactLinearLayout>

            <com.svd.svdagencies.utils.CompactLinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eve Return"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/tvEveReturn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/svd_text_label"
                    android:textStyle="bold" />
            </com.svd.svdagencies.utils.CompactLinearLayout>

        </GridLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/divider_line" />

        <!-- Calculations -->
        <com.svd.svdagencies.utils.CompactLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.svd.svdagencies.utils.CompactLinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Taken"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/tvTotalTaken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="@dimen/svd_text_label"
                    android:textStyle="bold" />
            </com.svd.svdagencies.utils.CompactLinearLayout>

            <com.svd.svdagencies.utils.CompactLinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Billed"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/tvTotalBilled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/icon_green"
                    android:textSize="@dimen/svd_text_label"
                    android:textStyle="bold" />
            </com.svd.svdagencies.utils.CompactLinearLayout>

            <com.svd.svdagencies.utils.CompactLinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remaining"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/tvRemainingQty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/svd_text_label"
                    android:textStyle="bold" />
            </com.svd.svdagencies.utils.CompactLinearLayout>

        </com.svd.svdagencies.utils.CompactLinearLayout>

    </com.svd.svdagencies.utils.CompactLinearLayout>
</com.google.android.material.card.MaterialCardView>
