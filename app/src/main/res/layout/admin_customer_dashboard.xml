                    <com.google.android.material.chip.Chip android:id="@+id/chipRetailer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="Retailers" android:textColor="@color/customer_type_chip_text" app:chipBackgroundColor="@color/customer_type_chip_background" app:chipStrokeColor="@color/customer_type_chip_stroke" app:chipStrokeWidth="1dp" android:textSize="@dimen/text_size_caption" android:paddingStart="0dp" android:paddingEnd="0dp" app:chipMinTouchTargetSize="48dp" app:chipStartPadding="3dp" app:chipEndPadding="3dp" app:textStartPadding="2dp" app:textEndPadding="2dp" app:chipIconVisible="false" app:checkedIconVisible="false"  app:ensureMinTouchTargetSize="true"  android:minHeight="48dp"  android:minWidth="48dp" />
