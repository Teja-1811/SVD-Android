<?xml version='1.0' encoding='utf-8'?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/window_background">
    <com.svd.svdagencies.utils.CompactLinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
