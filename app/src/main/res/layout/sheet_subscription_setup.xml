<?xml version="1.0" encoding="utf-8"?>
<com.svd.svdagencies.utils.CompactLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#DCE3E6" />
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">
        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set up your subscription"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:textSize="@dimen/svd_text_heading" />
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Review your plan and delivery details"
        android:textSize="@dimen/svd_text_label"
        android:textColor="#61727B"  android:visibility="gone" />
        </com.svd.svdagencies.utils.CompactLinearLayout>
        <com.google.android.material.button.MaterialButton
        android:id="@+id/subClose" style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:padding="0dp"
        android:minWidth="48dp"
        android:text="✕"
        android:textSize="@dimen/svd_text_heading"
        android:textColor="#61727B"
        android:contentDescription="Close subscription setup"  android:minHeight="48dp" />
    </com.svd.svdagencies.utils.CompactLinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false">
        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/svd_space_section"
        android:paddingTop="8dp">
            <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#EFF8F5"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color">
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:orientation="vertical">
                    <TextView
        android:id="@+id/subPlanName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />
                    <TextView
        android:id="@+id/subSchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="@dimen/svd_text_label"
        android:textColor="#526670" />
                    <TextView
        android:id="@+id/subPlanPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="@dimen/svd_text_title"
        android:textStyle="bold"
        android:textColor="#167D70" />
                    <TextView
        android:id="@+id/subPerDelivery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="@dimen/svd_text_label"
        android:textColor="#526670" />
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/svd_space_section"
        android:text="In every delivery"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/subProductRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="First delivery"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton
        android:id="@+id/subStartDate" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAllCaps="false"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/svd_text_label"
        app:cornerRadius="12dp"
        app:strokeColor="#D9E0E2"
        app:backgroundTint="?attr/colorSurface"  android:minHeight="@dimen/svd_touch_target"  android:minWidth="48dp" />
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/subDeliveryLabel"
        android:layout_marginTop="@dimen/svd_space_section"
        android:text="Delivery address"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Address (optional)"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="#D9E0E2">
                <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/subAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:maxLines="4"
        android:gravity="top"
        android:inputType="textPostalAddress|textMultiLine"
        android:textSize="@dimen/svd_text_body"
        android:textColor="?attr/colorOnSurface"
        android:minHeight="48dp"  android:minWidth="48dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </com.svd.svdagencies.utils.CompactLinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E3E9EB" />
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">
        <TextView
        android:id="@+id/subFooterPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/svd_text_label"
        android:textColor="#526670"
        android:gravity="center" />
        <com.google.android.material.button.MaterialButton
        android:id="@+id/subConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Confirm subscription"
        android:textAllCaps="false"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#167D70"
        app:cornerRadius="14dp"  android:minHeight="@dimen/svd_touch_target"  android:minWidth="48dp" />
    </com.svd.svdagencies.utils.CompactLinearLayout>
</com.svd.svdagencies.utils.CompactLinearLayout>
