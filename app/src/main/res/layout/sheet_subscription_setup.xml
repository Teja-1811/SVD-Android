<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <View android:layout_width="36dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:background="#DCE3E6" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="24dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Set up your subscription" android:textColor="#17323A" android:textStyle="bold" android:textSize="22sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Review your plan and delivery details" android:textSize="13sp" android:textColor="#61727B" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/subClose" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp" android:minWidth="0dp" android:text="✕" android:textSize="20sp" android:textColor="#61727B" android:contentDescription="Close subscription setup" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:paddingTop="8dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#EFF8F5" app:cardCornerRadius="@dimen/card_corner_radius_medium" app:strokeWidth="1dp" app:cardElevation="0dp" app:strokeColor="@color/card_stroke_color">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:orientation="vertical">
                    <TextView android:id="@+id/subPlanName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:textColor="#17323A" />
                    <TextView android:id="@+id/subSchedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="#526670" />
                    <TextView android:id="@+id/subPlanPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="28sp" android:textStyle="bold" android:textColor="#167D70" />
                    <TextView android:id="@+id/subPerDelivery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="#526670" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="In every delivery" android:textSize="16sp" android:textStyle="bold" android:textColor="#17323A" />
            <LinearLayout android:id="@+id/subProductRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="First delivery" android:textSize="16sp" android:textStyle="bold" android:textColor="#17323A" />
            <com.google.android.material.button.MaterialButton android:id="@+id/subStartDate" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:textColor="#17323A" android:textSize="15sp" app:cornerRadius="12dp" app:strokeColor="#D9E0E2" app:backgroundTint="#FFFFFF" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/subDeliveryLabel" android:layout_marginTop="20dp" android:text="Delivery address" android:textSize="16sp" android:textStyle="bold" android:textColor="#17323A" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Address (optional)" app:boxBackgroundMode="outline" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#D9E0E2">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/subAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="2" android:maxLines="4" android:gravity="top" android:inputType="textPostalAddress|textMultiLine" android:textSize="15sp" android:textColor="#17323A" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E3E9EB" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="16dp">
        <TextView android:id="@+id/subFooterPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#526670" android:gravity="center" />
        <com.google.android.material.button.MaterialButton android:id="@+id/subConfirm" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="Confirm subscription" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" app:backgroundTint="#167D70" app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
