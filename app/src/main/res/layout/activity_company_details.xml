<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/card_background"
        android:padding="@dimen/svd_space_section"
        tools:viewBindingIgnore="false"
        android:clipToPadding="false" android:fillViewport="true">
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical"
        android:padding="22dp">
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sri Vijaya Durga Milk Agencies"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/svd_text_heading"
        android:textStyle="bold" />
                    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_check"
        app:tint="#1DA1F2"
        android:contentDescription="Verified" />
                </com.svd.svdagencies.utils.CompactLinearLayout>
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Dairy distribution - Since 2024"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/svd_text_label" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/card_background"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical"
        android:padding="18dp">
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="About"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Website: https://svd-dqw3.onrender.com/"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/svd_text_label" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:id="@+id/agencyLicenceDetails"
        android:text="Loading registration details..."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/svd_text_label" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Registration details are managed by the agency."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/svd_text_label" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@color/card_background"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical"
        android:padding="18dp">
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contact"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Phone: +91 9392890375"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/svd_text_label" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Email: svdagencies12@gmail.com"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/svd_text_label" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Near Santa Market, Main Road, Gundugolanu, Eluru, Andhra Pradesh - 534427"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/svd_text_label" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@color/card_background"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical"
        android:padding="18dp">
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Operations"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Working hours: 5:30 AM - 10:00 PM"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/svd_text_label" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Service area: Gundugolanu And nearby Areas"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/svd_text_label" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Home delivery and store pickup available"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/svd_text_label" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenMap" style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Open in Google Maps"
        android:textAllCaps="false"  android:minHeight="@dimen/svd_touch_target"  android:minWidth="48dp" />
    </com.svd.svdagencies.utils.CompactLinearLayout>
</ScrollView>
