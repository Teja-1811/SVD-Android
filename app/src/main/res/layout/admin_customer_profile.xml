<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <include
            layout="@layout/admin_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <!-- Basic Profile Card -->
                <include
                    android:id="@+id/cardProfile"
                    layout="@layout/admin_customer_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"/>

                <!-- Extra Details Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xlarge"
                    app:cardCornerRadius="@dimen/card_corner_radius_small"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_stroke_color"
                    app:cardBackgroundColor="@color/card_background"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_large">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Additional Details"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold"
                            android:textColor="@color/textColorPrimary"
                            android:layout_marginBottom="@dimen/spacing_medium"/>

                        <!-- Customer ID -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/spacing_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Customer ID: "
                                android:textStyle="bold"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textColorPrimary"/>

                            <TextView
                                android:id="@+id/txtCustomerId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textColorSecondary"/>
                        </LinearLayout>

                        <!-- Retailer ID -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/spacing_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Retailer ID: "
                                android:textStyle="bold"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textColorPrimary"/>

                            <TextView
                                android:id="@+id/txtRetailerId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textColorSecondary"/>
                        </LinearLayout>

                        <!-- Status -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/spacing_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Status: "
                                android:textStyle="bold"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textColorPrimary"/>

                            <TextView
                                android:id="@+id/txtStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textColorSecondary"/>
                        </LinearLayout>

                        <!-- City -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/spacing_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="City: "
                                android:textStyle="bold"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textColorPrimary"/>

                            <TextView
                                android:id="@+id/txtCity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textColorSecondary"/>
                        </LinearLayout>

                        <!-- State -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="State: "
                                android:textStyle="bold"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textColorPrimary"/>

                            <TextView
                                android:id="@+id/txtState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textColorSecondary"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Update"
                        android:textSize="@dimen/text_size_body_small"
                        app:icon="@drawable/ic_edit"
                        app:backgroundTint="@color/brand_blue"
                        android:layout_marginEnd="@dimen/spacing_small"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFreeze"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Freeze"
                        android:textSize="@dimen/text_size_body_small"
                        app:icon="@drawable/ic_lock"
                        app:backgroundTint="@color/brand_red"
                        android:layout_marginStart="@dimen/spacing_small"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/card_background"
        android:layout_gravity="start"
        app:headerLayout="@layout/admin_nav_header"
        app:itemIconTint="@color/drawer_nav_icon_colors"
        app:itemTextColor="@color/drawer_nav_item_colors"
        app:menu="@menu/menu_admin_drawer"/>

</androidx.drawerlayout.widget.DrawerLayout>
