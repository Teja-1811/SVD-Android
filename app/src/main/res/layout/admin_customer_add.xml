<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/window_background">
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <include layout="@layout/admin_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
        <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
                <TextView
        android:id="@+id/tvFormSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fill the form to save customer details"
        android:textColor="@color/gray500"
        android:textSize="@dimen/text_size_body_small"
        android:layout_marginBottom="16dp"  android:visibility="gone" />
                <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke_color"
        android:background="@color/card_background"
        app:cardBackgroundColor="?attr/colorSurface"
        android:layout_marginBottom="@dimen/grid_16">
                    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical"
        android:padding="16dp">
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
                            <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_person"
        app:tint="@color/brand_blue"
        android:layout_marginEnd="8dp" />
                            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer Information"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_label" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
                            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entry Type *"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                            <Spinner
        android:popupBackground="@drawable/bg_delivery_dropdown"
        android:id="@+id/spinnerEntryType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="8dp"
        android:layout_marginBottom="4dp"
        android:minHeight="48dp"  android:minWidth="48dp" />
                            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Changing the type moves this record to the selected list."
        android:textColor="@color/gray500"
        android:textSize="@dimen/text_size_body_small"
        android:layout_marginBottom="16dp"  android:visibility="gone" />
                            <TextView
        android:id="@+id/tvCustomerNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer Name *"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                            <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etCustomerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="Enter Name"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"  android:minWidth="48dp" />
                            <TextView
        android:id="@+id/tvShopNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shop Name"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                            <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etShopName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="Enter Shop Name"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="text"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"  android:minWidth="48dp" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
                            <TextView
        android:id="@+id/tvRetailerIdLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Retailer ID"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                            <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etRetailerId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="Enter Retailer ID"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="text"
        android:focusable="false"
        android:clickable="false"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"  android:minWidth="48dp" />
                            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone Number *"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                            <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="+91"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="phone"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"  android:minWidth="48dp" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke_color"
        android:background="@color/card_background"
        app:cardBackgroundColor="?attr/colorSurface">
                    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical"
        android:padding="16dp">
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
                            <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_location_pin"
        app:tint="@color/brand_blue"
        android:layout_marginEnd="8dp" />
                            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shipping Address"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_label" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flat / Building No."
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                        <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etAddressLine1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="Enter Flat / Building No"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="textPostalAddress"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"  android:minWidth="48dp" />
                        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Area / Locality"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                        <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="Enter Area / Locality"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="textPostalAddress"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"  android:minWidth="48dp" />
                        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Route"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                        <AutoCompleteTextView style="@style/Widget.Svd.PlainInput"
        android:popupBackground="@drawable/bg_delivery_dropdown"
        android:id="@+id/actRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:completionThreshold="0"
        android:hint="Select Route"
        android:inputType="none"
        android:padding="12dp"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:textSize="@dimen/svd_text_body"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"  android:minWidth="48dp" />
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">
                                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PIN Code"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                                <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etPinCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="534427"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="number"
        android:minHeight="48dp"  android:minWidth="48dp" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">
                                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="City"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                                <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="GGL"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="text"
        android:minHeight="48dp"  android:minWidth="48dp" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
                                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="State"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="4dp" />
                                <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:hint="AP"
        android:textSize="@dimen/svd_text_body"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500"
        android:inputType="text"
        android:minHeight="48dp"  android:minWidth="48dp" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/window_background"
        android:elevation="0dp"
        android:gravity="end">
            <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textSize="@dimen/svd_text_label"
        android:textAllCaps="false"
        android:textColor="@color/gray500"
        app:strokeColor="@color/gray500"
        android:layout_marginEnd="16dp"  android:minHeight="48dp"  android:minWidth="48dp" />
            <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddCustomer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Customer"
        android:textSize="@dimen/svd_text_label"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:cornerRadius="@dimen/button_corner_radius"
        app:backgroundTint="@color/brand_blue"  android:minHeight="48dp"  android:textColor="@color/white"  android:minWidth="48dp" />
        </com.svd.svdagencies.utils.CompactLinearLayout>
    </com.svd.svdagencies.utils.CompactLinearLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:layout_gravity="start"
        app:headerLayout="@layout/admin_nav_header"
        app:itemIconTint="@color/drawer_nav_icon_colors"
        app:itemTextColor="@color/drawer_nav_item_colors"
        app:menu="@menu/menu_admin_drawer"
        app:backgroundTint="?attr/colorSurface" />
</androidx.drawerlayout.widget.DrawerLayout>
