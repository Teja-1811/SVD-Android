<?xml version="1.0" encoding="utf-8"?>
<com.svd.svdagencies.utils.CompactLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:background="@color/card_background"
    android:orientation="vertical"
    android:padding="@dimen/spacing_small"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvDenomLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹500"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_caption"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etDenomCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:inputType="number"
        android:padding="4dp"
        android:textSize="@dimen/text_size_medium"
        android:gravity="center"
        android:hint="0"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/gray500" android:minHeight="48dp" android:minWidth="48dp" />

    <TextView
        android:id="@+id/tvDenomTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0"
        android:textColor="@color/icon_green"
        android:textSize="@dimen/text_size_micro"
        android:layout_marginTop="2dp"
        android:textStyle="normal"/>

</com.svd.svdagencies.utils.CompactLinearLayout>
