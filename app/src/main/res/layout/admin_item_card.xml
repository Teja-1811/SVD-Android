<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium"
    android:layout_marginTop="@dimen/spacing_tiny"
    android:layout_marginStart="@dimen/spacing_tiny"
    android:layout_marginEnd="@dimen/spacing_tiny"
    app:cardCornerRadius="@dimen/card_corner_radius_medium"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke_color"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="130dp">

            <!-- Company Logo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCompanyLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_stroke_color"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true">

                <ImageView
                    android:id="@+id/imgCompanyLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_milk_placeholder"
                    android:padding="@dimen/spacing_xsmall"
                    android:scaleType="fitCenter"
                    android:background="@color/surface_background"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Product Image -->
            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_milk_placeholder"
                android:scaleType="fitCenter"/>

            <!-- Stock Badge -->
            <TextView
                android:id="@+id/tvStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:text="57 in stock"
                android:background="@drawable/bg_status_active"
                android:backgroundTint="@color/icon_green"
                android:textColor="@color/white"
                android:paddingStart="@dimen/spacing_xsmall"
                android:paddingEnd="@dimen/spacing_xsmall"
                android:paddingTop="@dimen/spacing_tiny"
                android:paddingBottom="@dimen/spacing_tiny"
                android:textSize="@dimen/text_size_micro"
                android:textStyle="bold"/>

        </RelativeLayout>

        <!-- Product Name -->
        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Cream Milk 120 ML"
            android:textSize="@dimen/text_size_body_small"
            android:maxLines="2"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary"
            android:layout_marginTop="@dimen/spacing_small"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_line"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_small"/>

        <!-- Details Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <!-- Code -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Code"
                    android:textSize="@dimen/text_size_micro"
                    android:textColor="@color/textColorSecondary"/>
                <TextView
                    android:id="@+id/tvCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FCM120"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="@color/textColorPrimary"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Company -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Company"
                    android:textSize="@dimen/text_size_micro"
                    android:textColor="@color/textColorSecondary"/>
                <TextView
                    android:id="@+id/tvCompany"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dodla"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="@color/textColorPrimary"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Buying -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_xsmall">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buying"
                    android:textSize="@dimen/text_size_micro"
                    android:textColor="@color/textColorSecondary"/>
                <TextView
                    android:id="@+id/tvBuyingPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹8.16"
                    android:textColor="@color/brand_blue"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Selling -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginTop="@dimen/spacing_xsmall">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selling"
                    android:textSize="@dimen/text_size_micro"
                    android:textColor="@color/textColorSecondary"/>
                <TextView
                    android:id="@+id/tvSellingPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹9.00"
                    android:textColor="@color/icon_green"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- MRP -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_xsmall">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MRP"
                    android:textSize="@dimen/text_size_micro"
                    android:textColor="@color/textColorSecondary"/>
                <TextView
                    android:id="@+id/tvMrp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹10.00"
                    android:textColor="@color/brand_red"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Margin -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginTop="@dimen/spacing_xsmall">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Margin"
                    android:textSize="@dimen/text_size_micro"
                    android:textColor="@color/textColorSecondary"/>
                <TextView
                    android:id="@+id/tvMargin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.84"
                    android:textColor="@color/icon_blue"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"/>
            </LinearLayout>

        </GridLayout>

        <!-- ======= UPDATED BUTTONS (More Intuitive) ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_medium"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Update"
                android:textSize="@dimen/text_size_caption"
                android:textAllCaps="false"
                android:textColor="@color/icon_green"
                app:strokeColor="@color/icon_green"
                app:cornerRadius="@dimen/spacing_xsmall"
                android:layout_marginEnd="@dimen/spacing_tiny"
                app:icon="@drawable/ic_edit"
                app:iconSize="14dp"
                app:iconTint="@color/icon_green"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_tiny"
                android:gravity="center"
                android:padding="@dimen/spacing_xsmall"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Deactivate"
                android:textSize="@dimen/text_size_micro"
                android:textAllCaps="false"
                android:textColor="@color/brand_red"
                app:strokeColor="@color/brand_red"
                app:cornerRadius="@dimen/spacing_xsmall"
                android:layout_marginStart="@dimen/spacing_tiny"
                app:icon="@drawable/ic_lock"
                app:iconSize="14dp"
                app:iconTint="@color/brand_red"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_tiny"
                android:gravity="center"
                android:padding="@dimen/spacing_xsmall"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>