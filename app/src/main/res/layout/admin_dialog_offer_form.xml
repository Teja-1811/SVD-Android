<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:fillViewport="true">
    <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="8dp" android:paddingEnd="24dp" android:paddingBottom="4dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Set one price for the complete bundle. Add products after saving." android:textColor="@color/textColorSecondary" android:textSize="@dimen/svd_text_label"  android:visibility="gone" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/svd_space_section" android:hint="Offer name" app:boxBackgroundMode="outline" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@null" app:hintEnabled="true">
            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input" android:id="@+id/etOfferName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:minHeight="@dimen/svd_touch_target" android:paddingTop="8dp" android:paddingBottom="8dp" android:textSize="@dimen/svd_text_body"  android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Offer audience" android:textColor="@color/textColorSecondary" />
        <Spinner android:popupBackground="@drawable/bg_delivery_dropdown" android:id="@+id/spinnerOfferFor" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/svd_touch_target" android:background="@drawable/bg_qty_outline" android:layout_marginTop="12dp" android:padding="8dp"  android:minWidth="48dp" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Description" app:boxBackgroundMode="outline" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@null" app:hintEnabled="true">
            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input" android:id="@+id/etOfferDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textMultiLine" android:minLines="2" android:minHeight="@dimen/svd_touch_target" android:paddingTop="8dp" android:paddingBottom="8dp" android:textSize="@dimen/svd_text_body"  android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Total bundle price" app:boxBackgroundMode="outline" app:prefixText="₹" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@null" app:hintEnabled="true">
            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input" android:id="@+id/etOfferPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:minHeight="@dimen/svd_touch_target" android:paddingTop="8dp" android:paddingBottom="8dp" android:textSize="@dimen/svd_text_body"  android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="Start date" app:boxBackgroundMode="outline" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@null" app:hintEnabled="true" android:layout_weight="1" android:layout_marginEnd="4dp">
                <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input" android:id="@+id/etOfferStartDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:minHeight="@dimen/svd_touch_target" android:paddingTop="8dp" android:paddingBottom="8dp" android:textSize="@dimen/svd_text_label" android:singleLine="true"  android:minWidth="48dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="End date" app:boxBackgroundMode="outline" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@null" app:hintEnabled="true" android:layout_weight="1" android:layout_marginEnd="4dp">
                <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input" android:id="@+id/etOfferEndDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:minHeight="@dimen/svd_touch_target" android:paddingTop="8dp" android:paddingBottom="8dp" android:textSize="@dimen/svd_text_label" android:singleLine="true"  android:minWidth="48dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </com.svd.svdagencies.utils.CompactLinearLayout>
    </com.svd.svdagencies.utils.CompactLinearLayout>
</ScrollView>