<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="8dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/window_background"
        android:padding="16dp">
        <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="@integer/svd_summary_columns"
        android:alignmentMode="alignMargins">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:orientation="vertical">
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_invoice_no"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small" />
                <TextView
        android:id="@+id/tvBillNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="#INV-0000"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_label"
        android:textStyle="bold" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:gravity="end"
        android:orientation="vertical">
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_date"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small" />
                <TextView
        android:id="@+id/tvBillDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="2024-01-01"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_label"
        android:textStyle="bold" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </GridLayout>
        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_customer_details"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small" />
            <TextView
        android:id="@+id/tvCustomerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Customer Name"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_label"
        android:textStyle="bold" />
        </com.svd.svdagencies.utils.CompactLinearLayout>
        <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/divider_line"
        android:alpha="0.5" />
        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="100"
        android:paddingBottom="4dp">
            <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="65"
        android:text="@string/label_item_header"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
            <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="15"
        android:text="@string/label_qty_header"
        android:gravity="center"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
            <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="20"
        android:text="@string/label_total_header"
        android:gravity="end"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
        </com.svd.svdagencies.utils.CompactLinearLayout>
        <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        tools:listitem="@layout/admin_bill_info_detail"
        tools:itemCount="2"
        android:clipToPadding="false" />
        <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/divider_line" />
        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_bill_total"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small" />
                <TextView
        android:id="@+id/tvBillAmount"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        tools:text="₹0.00"
        android:gravity="end"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_label"
        android:textStyle="bold" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </com.svd.svdagencies.utils.CompactLinearLayout>
    </com.svd.svdagencies.utils.CompactLinearLayout>
</com.google.android.material.card.MaterialCardView>
