<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/deliveryDrawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/window_background">
        <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetEnd="0dp"
        app:contentInsetLeft="0dp"
        app:contentInsetRight="0dp"
        app:contentInsetStart="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@color/textColorPrimary"
        app:navigationIconTint="?attr/colorPrimary">
            <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
                <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/spacing_small"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorPrimary"  android:contentDescription="@string/svd_a11y_btnmenu" />
                <TextView
        android:id="@+id/tvToolbarTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:gravity="start|center_vertical"
        android:text="Report"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layoutDatePicker"
        app:layout_constraintStart_toEndOf="@id/btnMenu"
        app:layout_constraintTop_toTopOf="parent" />
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutDatePicker"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_dashboard_chip"
        android:backgroundTint="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
                    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_calendar"
        app:tint="?attr/colorPrimary" />
                    <TextView
        android:id="@+id/tvSelectedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="2024-01-01"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/svd_text_label"
        android:textStyle="bold" />
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.MaterialToolbar>
        <com.svd.svdagencies.utils.AppSwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">
            <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/grid_16">
                    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_portal_hero">
                        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DELIVERY WORKSPACE"
        android:textSize="@dimen/svd_text_caption"
        android:textColor="?attr/colorPrimary"
        android:layout_marginTop="4dp"
        android:textStyle="bold" />
                        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Route overview"
        android:textSize="@dimen/svd_text_title"
        android:textColor="@color/textColorPrimary"
        android:layout_marginTop="4dp"
        android:textStyle="bold" />
                        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Collections, invoices and delivery activity."
        android:textSize="@dimen/svd_text_label"
        android:textColor="@color/textColorSecondary"
        android:layout_marginTop="4dp"  android:visibility="gone" />
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewOverallReport" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="View Full Month Report"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_graph"
        app:iconGravity="textStart"
        app:strokeColor="@color/brand_blue"
        app:strokeWidth="1.5dp"
        android:textColor="@color/brand_blue"  android:minHeight="@dimen/svd_touch_target"  android:minWidth="48dp" />
                    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAgentDues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grid_16"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke_color">
                        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">
                            <TextView
        android:id="@+id/tvAgentDuesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This Month Agent Dues"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
                                <TextView
        android:id="@+id/tvAgentBillCount"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Generated Bills\n0"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                                <TextView
        android:id="@+id/tvAgentCounterDue"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Bill Amount\nRs. 0.00"
        android:textColor="@color/icon_orange"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
                                <TextView
        android:id="@+id/tvAgentDeliveredAmount"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Paid\nRs. 0.00"
        android:textColor="@color/brand_blue"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                                <TextView
        android:id="@+id/tvAgentProfit"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Need To Submit\nRs. 0.00"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
                                <TextView
        android:id="@+id/tvAgentCollectedAmount"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Total Profit\nRs. 0.00"
        android:textColor="@color/icon_green"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                                <TextView
        android:id="@+id/tvAgentHoldingAmount"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Collected\nRs. 0.00"
        android:textColor="@color/brand_blue"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
                                <TextView
        android:id="@+id/tvAgentSalaryEarned"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Salary Earned\nRs. 0.00"
        android:textColor="@color/icon_green"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                                <TextView
        android:id="@+id/tvAgentRemainingAmount"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Salary Paid\nRs. 0.00"
        android:textColor="@color/icon_orange"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <TextView
        android:id="@+id/tvAgentSelfBillAmount"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Pending Salary\nRs. 0.00"
        android:textColor="@color/brand_blue"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
                                <TextView
        android:id="@+id/tvAgentSubmittedAmount"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Customer Bills\n0"
        android:textColor="@color/icon_green"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                                <TextView
        android:id="@+id/tvAgentDueAmount"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Self Bills\n0"
        android:textColor="@color/icon_orange"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                            </com.svd.svdagencies.utils.CompactLinearLayout>
                            <TextView
        android:id="@+id/tvAgentProfitAmount"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center"
        android:text="Items Sale\nRs. 0.00"
        android:textColor="@color/icon_green"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Items Delivered"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_label"
        android:textStyle="bold" />
                            <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAgentItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:clipToPadding="false" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Today Generated Bills"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
                    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTodayBills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="24dp"
        tools:listitem="@layout/delivery_today_bill" />
                    <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
                        <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieEmpty"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/empty_box" />
                        <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="All clear"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_heading"
        android:textStyle="bold" />
                        <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="No bills generated today."
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/svd_text_label" />
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.svd.svdagencies.utils.AppSwipeRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/deliveryNavigationView" style="@style/Widget.App.NavigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        app:backgroundTint="?attr/colorSurface"
        app:headerLayout="@layout/admin_nav_header"
        app:itemIconTint="@color/drawer_nav_icon_colors"
        app:itemTextColor="@color/drawer_nav_item_colors"
        app:menu="@menu/menu_delivery_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
