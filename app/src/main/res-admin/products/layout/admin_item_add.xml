<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/window_background">
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <include layout="@layout/admin_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
        <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Item Details"
        android:textSize="@dimen/text_size_small"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        android:layout_marginBottom="@dimen/spacing_large" />
                <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_large">
                    <ImageView
        android:id="@+id/imgItemPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_milk_placeholder"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_icon_btn_gray" />
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnSelectImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        app:fabSize="mini"
        app:srcCompat="@drawable/ic_edit"
        app:backgroundTint="?attr/colorSurface"
        app:tint="@color/icon_blue" />
                    <ImageView
        android:id="@+id/btnRemoveImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:src="@drawable/ic_add"
        android:rotation="45"
        app:tint="@color/red600"
        android:visibility="gone" />
                </FrameLayout>
                <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Item Name *"
        android:layout_marginBottom="@dimen/grid_12"
        app:hintTextAppearance="@style/TextSize11"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:inputType="textCapWords"
        android:minHeight="48dp"  android:minWidth="48dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Item Code"
        android:layout_marginBottom="@dimen/grid_12"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etItemCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:inputType="textCapCharacters"
        android:minHeight="48dp"  android:minWidth="48dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Company"
        android:textSize="@dimen/text_size_caption"
        android:textColor="@color/gray500"
        android:layout_marginBottom="@dimen/spacing_tiny" />
                <Spinner
        android:popupBackground="@drawable/bg_delivery_dropdown"
        android:id="@+id/spinnerCompany"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:layout_marginBottom="@dimen/spacing_large"
        android:minHeight="48dp"  android:minWidth="48dp" />
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textSize="@dimen/text_size_caption"
        android:textColor="@color/gray500"
        android:layout_marginBottom="@dimen/spacing_tiny" />
                <Spinner
        android:popupBackground="@drawable/bg_delivery_dropdown"
        android:id="@+id/spinnerCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:layout_marginBottom="@dimen/spacing_large"
        android:minHeight="48dp"  android:minWidth="48dp" />
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
                    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Buying Price"
        android:layout_marginEnd="@dimen/grid_8"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etBuyingPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:inputType="numberDecimal"
        android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Selling Price"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etSellingPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:inputType="numberDecimal"
        android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </com.svd.svdagencies.utils.CompactLinearLayout>
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/grid_12"
        android:baselineAligned="false">
                    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Base Price"
        android:layout_marginEnd="@dimen/grid_8"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etBasePrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:inputType="numberDecimal"
        android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="GST %"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etGst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:inputType="numberDecimal"
        android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </com.svd.svdagencies.utils.CompactLinearLayout>
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/grid_12"
        android:baselineAligned="false">
                    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="MRP"
        android:layout_marginEnd="@dimen/grid_8"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etMrp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:inputType="numberDecimal"
        android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="LTR"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etLtr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:inputType="numberDecimal"
        android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </com.svd.svdagencies.utils.CompactLinearLayout>
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/grid_12"
        android:orientation="horizontal"
        android:baselineAligned="false">
                    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Stock Qty"
        android:layout_marginEnd="@dimen/spacing_small" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:inputType="numberDecimal"
        android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Pcs Count" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etPcs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:text="1"
        android:inputType="number"
        android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </com.svd.svdagencies.utils.CompactLinearLayout>
                <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Description"
        android:layout_marginTop="@dimen/grid_12"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_body_small"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:gravity="top"
        android:minHeight="48dp"  android:minWidth="48dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_large"
        android:background="@color/surface_background"
        android:elevation="@dimen/spacing_tiny"
        android:gravity="end">
            <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/gray500"
        app:strokeColor="@color/gray500"
        android:layout_marginEnd="@dimen/spacing_large"  android:minHeight="48dp"  android:minWidth="48dp" />
            <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Item"
        android:textSize="@dimen/text_size_body_small"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:cornerRadius="@dimen/button_corner_radius"
        app:backgroundTint="@color/icon_blue"  android:minHeight="48dp"  android:minWidth="48dp" />
        </com.svd.svdagencies.utils.CompactLinearLayout>
    </com.svd.svdagencies.utils.CompactLinearLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:layout_gravity="start"
        app:headerLayout="@layout/admin_nav_header"
        app:itemIconTint="@color/drawer_nav_icon_colors"
        app:itemTextColor="@color/drawer_nav_item_colors"
        app:menu="@menu/menu_admin_drawer"
        app:backgroundTint="?attr/colorSurface" />
</androidx.drawerlayout.widget.DrawerLayout>
