<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:fillViewport="true">
    <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/svd_space_section">
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilItem" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Select Item" android:tag="svd-full-width">
            <AutoCompleteTextView style="@style/Widget.Svd.PlainInput" android:popupBackground="@drawable/bg_delivery_dropdown" android:id="@+id/actvItem" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:minHeight="48dp" android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="bottom" android:tag="svd-fixed-row" android:layout_marginTop="12dp">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="Type" android:layout_weight="1" android:layout_marginStart="0dp" android:layout_marginEnd="8dp">
                <AutoCompleteTextView style="@style/Widget.Svd.PlainInput" android:id="@+id/actvType" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:popupBackground="@drawable/bg_delivery_dropdown" android:minHeight="48dp" android:minWidth="48dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="Date" android:layout_weight="1" android:layout_marginStart="0dp" android:layout_marginEnd="0dp">
                <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input" android:id="@+id/etDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="false" android:inputType="none" android:minHeight="48dp" android:minWidth="48dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </com.svd.svdagencies.utils.CompactLinearLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Quantity">
            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input" android:id="@+id/etQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:minHeight="48dp" android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Notes (Optional)">
            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input" android:id="@+id/etNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textMultiLine" android:minLines="2" android:minHeight="48dp" android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
    </com.svd.svdagencies.utils.CompactLinearLayout>
</ScrollView>