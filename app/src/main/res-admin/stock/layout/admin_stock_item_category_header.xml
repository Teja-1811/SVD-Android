<?xml version="1.0" encoding="utf-8"?>
<com.svd.svdagencies.utils.CompactLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="8dp"
    android:background="@color/surface_background">

    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tvCategoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Milk"
            android:textColor="@color/textColorPrimary"
            android:textSize="@dimen/svd_text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 items"
            android:textColor="@color/textColorSecondary"
            android:textSize="@dimen/svd_text_label"
            android:layout_marginTop="2dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="12dp" />
    </com.svd.svdagencies.utils.CompactLinearLayout>

    <!-- Column Headers -->
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#EEF2FF"
        android:paddingVertical="8dp"
        android:paddingHorizontal="20dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Item"
            android:textColor="#3F51B5"
            android:textSize="@dimen/svd_text_label"
            android:textStyle="bold" />

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Current"
            android:textColor="#3F51B5"
            android:textSize="@dimen/svd_text_label"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Crates"
            android:textColor="#3F51B5"
            android:textSize="@dimen/svd_text_label"
            android:textStyle="bold"
            android:gravity="center" />
    </com.svd.svdagencies.utils.CompactLinearLayout>

</com.svd.svdagencies.utils.CompactLinearLayout>
