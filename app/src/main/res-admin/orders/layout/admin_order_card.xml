<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/grid_16"
    app:cardCornerRadius="@dimen/card_corner_radius_medium"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke_color"
    app:cardBackgroundColor="@color/card_background">

    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <com.svd.svdagencies.utils.CompactLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ORD-2026..."
                android:textStyle="bold"
                android:textSize="@dimen/svd_text_label"
                android:textColor="@color/textColorPrimary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:background="@drawable/bg_qty_outline"
                android:backgroundTint="@color/icon_orange"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="@dimen/text_size_body_small"
                android:textColor="@color/white"/>
        </com.svd.svdagencies.utils.CompactLinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_line"/>

        <!-- Details -->
        <com.svd.svdagencies.utils.CompactLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView android:id="@+id/tvCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer: Test"
                android:textSize="@dimen/svd_text_label"
                android:textStyle="bold"
                android:textColor="@color/textColorPrimary"/>

            <TextView android:id="@+id/tvOrderDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Order Date: Jan 16, 2026"
                android:textSize="@dimen/text_size_body_small"
                android:layout_marginTop="4dp"
                android:textColor="@color/textColorSecondary"/>

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Items:"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/svd_text_label"
                android:textColor="@color/textColorPrimary"/>

            <!-- Items Table Header -->
            <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.5" android:text="Item" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:textColor="@color/textColorPrimary"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Qty" android:gravity="center" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:textColor="@color/textColorPrimary"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Disc" android:gravity="center" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:textColor="@color/textColorPrimary"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="AQ" android:gravity="center" android:textSize="@dimen/text_size_body_small" android:textStyle="bold" android:textColor="@color/textColorPrimary"/>
            </com.svd.svdagencies.utils.CompactLinearLayout>

            <!-- Dynamic Items Container -->
            <com.svd.svdagencies.utils.CompactLinearLayout android:id="@+id/layoutItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        </com.svd.svdagencies.utils.CompactLinearLayout>

        <!-- Actions -->
        <com.svd.svdagencies.utils.CompactLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/grid_8">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/button_confirm"
                app:backgroundTint="@color/icon_green"
                android:layout_marginEnd="@dimen/grid_4"
                app:icon="@drawable/ic_check"
                android:textSize="@dimen/text_size_body_small"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="@dimen/button_corner_radius"
                android:textColor="@color/white"
                app:iconTint="@color/white" android:minHeight="48dp"  android:minWidth="48dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/button_reject"
                app:backgroundTint="?attr/colorPrimary"
                android:layout_marginStart="@dimen/grid_4"
                app:icon="@drawable/ic_close"
                android:textSize="@dimen/text_size_body_small"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="@dimen/button_corner_radius"
                android:textColor="?attr/colorOnPrimary"
                app:iconTint="?attr/colorOnPrimary" android:minHeight="48dp"  android:minWidth="48dp" />
        </com.svd.svdagencies.utils.CompactLinearLayout>
    </com.svd.svdagencies.utils.CompactLinearLayout>
</com.google.android.material.card.MaterialCardView>