<?xml version="1.0" encoding="utf-8"?>
<com.svd.svdagencies.utils.CompactLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="6dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.5"
        android:text="Item Name"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="@color/textColorPrimary" />

    <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etQty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_qty_outline"
        android:gravity="center"
        android:inputType="number"
        android:textSize="@dimen/text_size_body_small"
        android:layout_marginHorizontal="4dp"
        android:padding="4dp" android:minHeight="48dp" android:minWidth="48dp" />

    <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etDisc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_qty_outline"
        android:gravity="center"
        android:inputType="numberDecimal"
        android:textSize="@dimen/text_size_body_small"
        android:layout_marginHorizontal="4dp"
        android:padding="4dp" android:minHeight="48dp" android:minWidth="48dp" />

    <TextView
        android:id="@+id/tvAQ"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:gravity="center"
        android:text="0"
        android:textSize="@dimen/text_size_body_small"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"/>
</com.svd.svdagencies.utils.CompactLinearLayout>
