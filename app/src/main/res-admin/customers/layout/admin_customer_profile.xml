                            <TextView android:id="@+id/txtState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="@dimen/text_size_caption" android:textColor="@color/textColorSecondary" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
