                        </com.svd.svdagencies.utils.CompactLinearLayout>
                        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="@dimen/spacing_small">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="City: " android:textStyle="bold" android:textSize="@dimen/text_size_caption" android:textColor="@color/textColorPrimary" />
                            <TextView android:id="@+id/txtCity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="@dimen/text_size_caption" android:textColor="@color/textColorSecondary" />
                        </com.svd.svdagencies.utils.CompactLinearLayout>
                        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
