                    <com.google.android.material.button.MaterialButton android:id="@+id/btnUpdate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Update" android:textSize="@dimen/svd_text_caption" app:icon="@drawable/ic_edit" app:backgroundTint="@color/brand_blue" android:layout_marginEnd="3dp" android:singleLine="true" android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginStart="3dp" app:iconSize="16dp" app:iconPadding="4dp"  android:minHeight="48dp"  android:textColor="@color/white"  android:minWidth="48dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnFreeze" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Freeze" android:textSize="@dimen/svd_text_caption" app:icon="@drawable/ic_lock" app:backgroundTint="?attr/colorPrimary" android:layout_marginStart="3dp" android:singleLine="true" android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="3dp" app:iconSize="16dp" app:iconPadding="4dp"  android:minHeight="48dp"  android:minWidth="48dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteCustomer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Delete" app:icon="@drawable/ic_trash" app:backgroundTint="@color/red600" android:textSize="@dimen/svd_text_caption" android:singleLine="true" android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" app:iconSize="16dp" app:iconPadding="4dp"  android:minHeight="48dp"  android:textColor="@color/white"  android:minWidth="48dp" />
