<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="0dp" android:paddingVertical="0dp" android:layout_marginHorizontal="12dp" android:background="@android:color/white" android:baselineAligned="false">

    <TextView android:id="@+id/tvDueDate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:textColor="@color/textColorPrimary" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:gravity="center_vertical" android:background="@drawable/bg_due_table_cell" />

    <TextView android:id="@+id/tvDueAgent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4" android:textColor="@color/textColorPrimary" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:gravity="center_vertical" android:background="@drawable/bg_due_table_cell" /><TextView android:id="@+id/tvDueCollected" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="end|center_vertical" android:textColor="@color/textColorPrimary" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:background="@drawable/bg_due_table_cell" />

    <TextView android:id="@+id/tvDueSubmitted" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="end|center_vertical" android:textColor="@color/textColorPrimary" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:background="@drawable/bg_due_table_cell" />

    <TextView android:id="@+id/tvDueBalance" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="end|center_vertical" android:textColor="@color/textColorPrimary" android:textStyle="bold" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:background="@drawable/bg_due_table_cell" />
</LinearLayout>