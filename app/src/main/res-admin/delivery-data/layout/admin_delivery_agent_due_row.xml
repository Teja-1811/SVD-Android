<?xml version='1.0' encoding='utf-8'?>
<com.svd.svdagencies.utils.ScrollableTableRow xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="wrap_content"  android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="0dp" android:paddingVertical="0dp"  android:background="@android:color/white" android:baselineAligned="false">

    <TextView android:id="@+id/tvDueDate" android:layout_width="120dp" android:singleLine="true" android:layout_height="match_parent" android:textColor="@color/textColorPrimary" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:gravity="center" android:background="@drawable/bg_due_table_cell" />

    <TextView android:id="@+id/tvDueAgent" android:layout_width="180dp" android:singleLine="true" android:layout_height="match_parent" android:textColor="@color/textColorPrimary" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:gravity="center" android:background="@drawable/bg_due_table_cell" /><TextView android:id="@+id/tvDueOpening" android:layout_width="120dp" android:singleLine="true" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/textColorPrimary" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:background="@drawable/bg_due_table_cell" /><TextView android:id="@+id/tvDueCollected" android:layout_width="120dp" android:singleLine="true" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/textColorPrimary" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:background="@drawable/bg_due_table_cell" />

    <TextView android:id="@+id/tvDueTotal" android:layout_width="120dp" android:singleLine="true" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/textColorPrimary" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:background="@drawable/bg_due_table_cell" /><TextView android:id="@+id/tvDueSubmitted" android:layout_width="120dp" android:singleLine="true" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/textColorPrimary" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:background="@drawable/bg_due_table_cell" />

    <TextView android:id="@+id/tvDueBalance" android:layout_width="120dp" android:singleLine="true" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/textColorPrimary" android:textStyle="bold" android:textSize="12sp" android:minHeight="44dp" android:padding="6dp" android:background="@drawable/bg_due_table_cell" />
</LinearLayout>
</com.svd.svdagencies.utils.ScrollableTableRow>
