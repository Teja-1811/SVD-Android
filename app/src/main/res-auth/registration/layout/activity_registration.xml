<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/window_background"
        android:fillViewport="true"
        android:clipToPadding="false">
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/svd_space_section">
        <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack" style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="‹ Back"
        android:textColor="?attr/colorPrimary"  android:minHeight="48dp"  android:minWidth="48dp" />
        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Create your account"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_title"
        android:textStyle="bold" />
        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your account will be activated after administrator verification."
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/svd_text_label" />
        <RadioGroup
        android:id="@+id/registrationTypeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">
            <RadioButton
        android:id="@+id/rbUser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:checked="true"
        android:text="User"  android:minHeight="48dp"  android:minWidth="48dp" />
            <RadioButton
        android:id="@+id/rbRetailer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Retailer"  android:minHeight="48dp"  android:minWidth="48dp" />
        </RadioGroup>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Svd.FormField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/svd_space_section"
        android:hint="Full name"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">
            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etRegistrationName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPersonName"
        android:minHeight="48dp"  android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Svd.FormField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Mobile number"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">
            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etRegistrationPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="phone"
        android:minHeight="48dp"  android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Svd.FormField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Shop name (optional)"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">
            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etRegistrationShop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"  android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Svd.FormField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Area (optional)"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">
            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etRegistrationArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"  android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Svd.FormField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Password (minimum 6 characters)"
        app:endIconMode="password_toggle"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">
            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Svd.Input"
        android:id="@+id/etRegistrationPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword"
        android:minHeight="48dp"  android:minWidth="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReadTerms" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Read Terms and Conditions"
        android:textAllCaps="false"  android:minHeight="48dp"  android:minWidth="48dp" />
        <TextView
        android:id="@+id/tvTermsInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open the terms before accepting them."
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/svd_text_label" />
        <CheckBox
        android:id="@+id/cbAcceptTerms"
        android:enabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="top"
        android:text="I accept the Terms and Conditions and agree to submit my details for account verification."
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_label"  android:minHeight="48dp"  android:minWidth="48dp" />
        <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitRegistration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Submit registration"
        android:textAllCaps="false"
        android:textSize="@dimen/svd_text_body"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="16dp"  android:minHeight="@dimen/svd_touch_target"  android:minWidth="48dp" />
    </com.svd.svdagencies.utils.CompactLinearLayout>
</ScrollView>
