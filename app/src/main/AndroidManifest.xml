<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:theme="@style/Theme.SVDAgency"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".ui.auth.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.LoginActivity" />

        <!-- Admin -->
        <activity android:name=".ui.admin.AdminDashboardActivity"/>
        <activity android:name=".ui.admin.customer.CustomersData"/>
        <activity android:name=".ui.admin.customer.CustomerProfileActivity"/>
        <activity android:name=".ui.admin.customer.AddCustomerActivity"/>
        <activity android:name=".ui.admin.bills.AdminBillsActivity"/>
        <activity
            android:name=".ui.admin.bills.CreateBillActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.admin.bills.AdminBillDetailActivity"/>
        <activity android:name=".ui.admin.AdminOrdersActivity"/>
        <activity android:name=".ui.admin.items.AdminItemsActivity"/>
        <activity android:name=".ui.admin.items.AddEditItemActivity"/>
        <activity android:name=".ui.admin.stock.AdminStockActivity"/>
        <activity android:name=".ui.admin.stock.AdminStockUpdateActivity"/>
        <activity android:name=".ui.admin.AdminDuesActivity"/>
        <activity android:name=".ui.admin.cashbook.AdminCashBookActivity"/>
        <activity android:name=".ui.admin.cashbook.AdminStatementActivity"/>
        <activity android:name=".ui.admin.cashbook.AddExpenseActivity"/>
        <activity android:name=".ui.admin.cashbook.ViewExpensesActivity"/>
        <activity android:name=".ui.admin.AdminPaymentsActivity"/>
        <activity android:name=".ui.admin.AdminMonthlySummary"/>
        <activity android:name=".ui.admin.companies.AdminCompaniesActivity"/>
        <activity android:name=".ui.admin.companies.AddEditCompanyActivity"/>
        <activity android:name=".ui.admin.companies.CompanyCatalogActivity"/>
        <activity android:name=".ui.admin.AdminDeliveryAgentDuesActivity"/>
        <activity android:name=".ui.admin.AdminEnquiriesActivity"/>

        <!-- Customer / User -->
        <activity android:name=".ui.customer.CustomerMainActivity"/>
        <activity android:name=".ui.customer.CustomerCompanyCatalogActivity"/>
        <activity android:name=".ui.customer.CustomerCompanyDetailsActivity"/>
        <activity android:name=".ui.customer.CustomerContactSupportActivity"/>
        <activity android:name=".ui.customer.CustomerRaisedQueriesActivity"/>
        <activity android:name=".ui.customer.CustomerStatementActivity"/>
        <activity android:name=".ui.customer.PhonePeCheckoutActivity"/>
        <activity android:name=".ui.customer.TermsConditionsActivity"/>

        <!-- Deliver -->
        <activity android:name=".ui.delivery.DeliveryDashboardActivity"/>
        <activity android:name=".ui.delivery.DeliveryPaymentsActivity"/>
        <activity android:name=".ui.delivery.DeliveryStockEntryActivity"/>
        <activity android:name=".ui.delivery.DeliveryStockPhaseEntryActivity"/>
        <activity android:name=".ui.delivery.DeliveryStockHistoryActivity"/>
        <activity android:name=".ui.delivery.DeliveryOverallReportActivity"/>
        <activity
            android:name=".ui.delivery.DeliveryCreateBillActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.delivery.DeliveryBillToCustomerActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.delivery.DeliveryBillHistoryActivity"/>
        <activity android:name=".ui.delivery.DeliveryCustomerPaymentsActivity"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".notifications.SvdFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
