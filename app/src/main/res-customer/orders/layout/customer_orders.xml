<?xml version='1.0' encoding='utf-8'?>
<com.svd.svdagencies.utils.AppSwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/window_background">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_medium">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Order for your shop" android:textSize="@dimen/svd_text_title" android:textColor="@color/textColorPrimary" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Build your next retailer order." android:textSize="@dimen/svd_text_label" android:textColor="@color/textColorSecondary" android:layout_marginBottom="16dp"  android:visibility="gone" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_medium" android:scrollbars="none" android:clipToPadding="false">
                <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleLine="true" app:singleSelection="true" />
            </HorizontalScrollView>
            <TextView android:id="@+id/tvOrderingWindow" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_medium" android:text="Checking regular order timings. Pre-orders are available 24 hours." android:textColor="@color/textColorSecondary" android:textSize="@dimen/text_size_small" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_medium" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="@dimen/card_corner_radius_medium" app:strokeColor="@color/card_stroke_color" app:strokeWidth="1dp" app:cardElevation="0dp">
                <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Delivery type" android:textColor="@color/textColorPrimary" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/orderTypeToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:singleSelection="true" app:selectionRequired="true" android:visibility="gone">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnRegularOrder" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:text="Regular delivery"  android:minHeight="48dp"  android:minWidth="48dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnPreOrder" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pre-order" android:visibility="gone"  android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <TextView android:id="@+id/tvRegularDeliveryHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Regular orders are delivered with your delivery agent's next route visit." android:textColor="@color/textColorSecondary" android:textSize="@dimen/svd_text_label"  android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPreOrderDate" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Select pre-order delivery date" android:visibility="gone"  android:minHeight="48dp"  android:minWidth="48dp" />
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvOrders" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:paddingBottom="@dimen/spacing_medium" android:clipToPadding="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardOrderSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_medium" android:layout_marginBottom="@dimen/spacing_xlarge" app:cardCornerRadius="@dimen/card_corner_radius_medium" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/card_stroke_color">
                <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/editTextBackground" android:orientation="vertical" android:padding="@dimen/spacing_large">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Order Summary" android:textSize="@dimen/text_size_large" android:textStyle="bold" android:textColor="@color/textColorPrimary" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_medium" android:clipToPadding="false" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/editTextStroke" android:layout_marginTop="@dimen/spacing_medium" />
                    <com.svd.svdagencies.utils.CompactLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="@dimen/spacing_medium">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total:" android:textSize="@dimen/text_size_medium" android:textStyle="bold" android:textColor="@color/textColorPrimary" />
                        <TextView android:id="@+id/tvTotalAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0.00" android:textSize="@dimen/text_size_medium" android:textStyle="bold" android:textColor="@color/textColorPrimary" />
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                    <TextView android:id="@+id/tvOrderDeliveryCharge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Delivery charge: ₹10.00" android:textColor="@color/textColorSecondary" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPlaceOrder" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_large" android:text="Place Order" android:textAllCaps="false" android:textSize="@dimen/text_size_button" app:cornerRadius="@dimen/card_corner_radius_large" app:backgroundTint="@color/icon_green"  android:minHeight="@dimen/svd_touch_target"  android:textColor="@color/white"  android:minWidth="48dp" />
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </com.svd.svdagencies.utils.CompactLinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.svd.svdagencies.utils.AppSwipeRefreshLayout>