<?xml version="1.0" encoding="utf-8"?>
<com.svd.svdagencies.utils.AppSwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/user_portal_background"
        tools:context=".ui.customer.fragment.CustomerPaymentFragment">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        android:padding="@dimen/grid_16">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment Center"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_heading"
        android:textStyle="bold" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Settle your dues and manage wallet balance"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/svd_text_label"  android:visibility="gone" />
            <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/svd_space_section"
        android:layout_marginBottom="@dimen/svd_space_section"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/svd_space_section">
                    <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/paymentOutstandingCard"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
                        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Outstanding Due"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small" />
                        <TextView
        android:id="@+id/tvCurrentDue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="₹0.00"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/svd_text_heading"
        android:textStyle="bold" />
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                    <View
        android:id="@+id/paymentBalanceDivider"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:background="@color/divider_line" />
                    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
                        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Advance Wallet"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small" />
                        <TextView
        android:id="@+id/tvCurrentBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="₹0.00"
        android:textColor="@color/icon_green"
        android:textSize="@dimen/svd_text_heading"
        android:textStyle="bold" />
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Add Payment"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="1dp">
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/svd_space_section">
                    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/window_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
                        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/svd_text_title"
        android:textStyle="bold" />
                        <EditText style="@style/Widget.Svd.PlainInput"
        android:id="@+id/etPayAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@null"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:imeOptions="actionDone"
        android:singleLine="true"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold"
        android:minHeight="48dp"  android:minWidth="48dp" />
                    </com.svd.svdagencies.utils.CompactLinearLayout>
                    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPayUpi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/svd_space_section"
        android:text="Pay with UPI"
        android:textAllCaps="false"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="?attr/colorOnPrimary"  android:minHeight="@dimen/svd_touch_target"  android:minWidth="48dp" />
                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="8dp"
        android:text="Secure UPI Payment"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/text_size_body_small"
        app:drawableTint="@color/icon_green" />
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
                <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Recent History"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
                <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
                    <ImageButton
        android:id="@+id/btnPrevMonth"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:tint="?attr/colorPrimary" />
                    <TextView
        android:id="@+id/tvMonthLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:text="OCT 2023"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />
                    <ImageButton
        android:id="@+id/btnNextMonth"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_forward"
        app:tint="?attr/colorPrimary" />
                </com.svd.svdagencies.utils.CompactLinearLayout>
            </com.svd.svdagencies.utils.CompactLinearLayout>
            <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPaymentHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="40dp"
        tools:listitem="@layout/customer_payment_row" />
            <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutEmptyHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/svd_space_section"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
                <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:alpha="0.2"
        android:src="@drawable/ic_payments"
        app:tint="@color/textColorSecondary" />
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="No records found for this month"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/svd_text_label" />
            </com.svd.svdagencies.utils.CompactLinearLayout>
        </com.svd.svdagencies.utils.CompactLinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.svd.svdagencies.utils.AppSwipeRefreshLayout>
