<?xml version="1.0" encoding="utf-8"?>
<com.svd.svdagencies.utils.CompactLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="@dimen/svd_space_section">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Bill"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_heading"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvConfirmCustomer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/svd_text_label"
        tools:text="Customer: John Doe" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/divider_line" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConfirmItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/user_cart_summary_item"
        android:clipToPadding="false" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/divider_line" />
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Grand Total"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
        <TextView
        android:id="@+id/tvConfirmTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold"
        tools:text="₹ 450.00" />
    </com.svd.svdagencies.utils.CompactLinearLayout>
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutCollectedAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Collected Amount"
        android:textColor="@color/textColorSecondary"
        android:textSize="@dimen/svd_text_label" />
        <TextView
        android:id="@+id/tvConfirmCollected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_label"
        tools:text="₹ 100.00" />
    </com.svd.svdagencies.utils.CompactLinearLayout>
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:id="@+id/layoutRemainingDue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Remaining Due"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold" />
        <TextView
        android:id="@+id/tvConfirmRemainingDue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/svd_text_body"
        android:textStyle="bold"
        tools:text="₹ 350.00" />
    </com.svd.svdagencies.utils.CompactLinearLayout>
    <com.svd.svdagencies.utils.CompactLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/svd_space_section"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpi" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:text="UPI"
        android:textAllCaps="false"
        app:cornerRadius="8dp"
        app:strokeColor="?attr/colorPrimary"
        android:textColor="?attr/colorPrimary"  android:minHeight="@dimen/svd_touch_target"  android:minWidth="48dp" />
        <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Confirm"
        android:textAllCaps="false"
        app:backgroundTint="@color/green_status"
        app:cornerRadius="8dp"  android:textColor="@color/white"  android:minHeight="@dimen/svd_touch_target"  android:minWidth="48dp" />
    </com.svd.svdagencies.utils.CompactLinearLayout>
</com.svd.svdagencies.utils.CompactLinearLayout>
